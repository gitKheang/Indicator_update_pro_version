exec5mSwingBearCHoCH = phase5ExecSwingBearChochConfirmed
exec5mBullCHoCH = phase5ExecBullChochConfirmed
exec5mBearCHoCH = phase5ExecBearChochConfirmed
exec5mBullReaction = phase5ExecBullReactionConfirmed
exec5mBearReaction = phase5ExecBearReactionConfirmed
