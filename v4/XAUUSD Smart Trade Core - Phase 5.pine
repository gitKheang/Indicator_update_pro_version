// Compatibility aliases keep the original nearest-candidate Phase 5 contract.
setup15mDemandTop = setup15mDemand1Top
setup15mDemandBottom = setup15mDemand1Bottom
setup15mSupplyTop = setup15mSupply1Top
setup15mSupplyBottom = setup15mSupply1Bottom
setup15mBullOBTop = setup15mBullOB1Top
setup15mBullOBBottom = setup15mBullOB1Bottom
setup15mBearOBTop = setup15mBearOB1Top
setup15mBearOBBottom = setup15mBearOB1Bottom
setup15mBullFVGTop = setup15mBullFVG1Top
setup15mBullFVGBottom = setup15mBullFVG1Bottom
setup15mBearFVGTop = setup15mBearFVG1Top
setup15mBearFVGBottom = setup15mBearFVG1Bottom
setup15mPivotSupportTop = setup15mPivotSupport1Top
setup15mPivotSupportBottom = setup15mPivotSupport1Bottom
setup15mPivotResistanceTop = setup15mPivotResistance1Top
setup15mPivotResistanceBottom = setup15mPivotResistance1Bottom

setup15mDemand = setup15mDemandTop
setup15mSupply = setup15mSupplyBottom
setup15mBullOB = setup15mBullOBTop
setup15mBearOB = setup15mBearOBBottom
setup15mBullFVG = math.avg(setup15mBullFVGTop, setup15mBullFVGBottom)
setup15mBearFVG = math.avg(setup15mBearFVGTop, setup15mBearFVGBottom)
setup15mPivotSupport = setup15mPivotSupportTop
setup15mPivotResistance = setup15mPivotResistanceBottom
setup15mEQH1 = phase5SetupStateRaw.eqh1.level
setup15mEQH1Origin = phase5SetupStateRaw.eqh1.origin
setup15mEQH1Confirmed = phase5SetupStateRaw.eqh1.confirmed
setup15mEQH2 = phase5SetupStateRaw.eqh2.level
setup15mEQH2Origin = phase5SetupStateRaw.eqh2.origin
setup15mEQH2Confirmed = phase5SetupStateRaw.eqh2.confirmed
