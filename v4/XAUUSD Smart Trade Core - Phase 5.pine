//
// Lean calculation-only split of:
// "SMC & ICT & Indicators + Scalping Master"
// The identical v3 full script remains available as a recovery/parity copy.
//
//@version=5
indicator(title="XAUUSD Smart Trade Core — Phase 5", overlay=true, max_bars_back=500)

// =============================================================================
// LEAN CORE — REQUIRED INPUT CONTRACT
// Defaults intentionally match the full v4 master. Do not tune during parity.
// =============================================================================

length = input.int(50, "Swing Length", minval=10, group="Lean Core — Structure")
ifilter_confluence = input.bool(false, "Internal Confluence Filter", group="Lean Core — Structure")
ob_filter = input.string("Atr", "Order Block Filter", options=["Atr", "Cumulative Mean Range"], group="Lean Core — 15m AOI")

eq_len = input.int(3, "EQH/EQL Bars Confirmation", minval=1, group="Lean Core — 15m AOI")
eq_threshold = input.float(0.1, "EQH/EQL Threshold", minval=0, maxval=0.5, step=0.1, group="Lean Core — 15m AOI")
fvg_auto = input.bool(true, "FVG Auto Threshold", group="Lean Core — 15m AOI")

ds_min_pc_change = input.float(0.05, "D/S Min % change", minval=0, step=0.2, group="Lean Core — 15m AOI")
ds_max_pc_zone = input.float(0.05, "D/S Max % zone height", minval=0, step=0.2, group="Lean Core — 15m AOI")

left = input.int(20, "Pivot Look Left", group="Lean Core — Pivot S/R")
right = input.int(15, "Pivot Look Right", group="Lean Core — Pivot S/R")
nPiv = input.int(1, "Number of Pivots", group="Lean Core — Pivot S/R")
atrLen = input.int(30, "Pivot ATR Length", group="Lean Core — Pivot S/R")
mult = input.float(0.5, "Pivot Zone Width (ATR)", step=0.1, group="Lean Core — Pivot S/R")
per = input.float(5.0, "Pivot Max Zone Percent", group="Lean Core — Pivot S/R")
src = input.string("HA", "Pivot Source", options=["HA", "High/Low Body", "High/Low"], group="Lean Core — Pivot S/R")
alignZones = input.bool(true, "Align Pivot Zones", group="Lean Core — Pivot S/R")
dhighs = input.bool(true, "Detect Pivot Highs", group="Lean Core — Pivot S/R")
dlows = input.bool(true, "Detect Pivot Lows", group="Lean Core — Pivot S/R")

macdFast = input.int(12, "MACD Fast Length", minval=2, group="Lean Core — Dashboard")
macdSlow = input.int(26, "MACD Slow Length", minval=2, group="Lean Core — Dashboard")
macdSignal = input.int(9, "MACD Signal Length", minval=2, group="Lean Core — Dashboard")
smoothK = input.int(3, "Stochastic RSI K", minval=2, group="Lean Core — Dashboard")
smoothD = input.int(3, "Stochastic RSI D", minval=2, group="Lean Core — Dashboard")
lengthRSI = input.int(14, "Stochastic RSI Length", minval=2, group="Lean Core — Dashboard")
lengthStoch = input.int(14, "Stochastic Length", minval=2, group="Lean Core — Dashboard")
vortexLength = input.int(14, "Vortex Length", minval=2, group="Lean Core — Dashboard")
momLength = input.int(14, "Momentum Length", minval=2, group="Lean Core — Dashboard")
rsiLength = input.int(14, "RSI Length", minval=2, group="Lean Core — Dashboard")
psarStart = input.float(0.02, "PSAR Start", minval=0.01, group="Lean Core — Dashboard")
psarInc = input.float(0.02, "PSAR Increment", minval=0.01, group="Lean Core — Dashboard")
psarMax = input.float(0.2, "PSAR Max", minval=0.01, group="Lean Core — Dashboard")
dmiLength = input.int(14, "DMI Length", minval=2, group="Lean Core — Dashboard")
dmiSmooth = input.int(14, "DMI Smoothing", minval=2, group="Lean Core — Dashboard")
mfiLength = input.int(14, "Money Flow Index Length", minval=2, group="Lean Core — Dashboard")
fisherLength = input.int(14, "Fisher Length", minval=2, group="Lean Core — Dashboard")

// =============================================================================
// LEAN CORE — SHARED HELPERS
// =============================================================================

swings(len) =>
    var os = 0
    upper = ta.highest(len)
    lower = ta.lowest(len)
    os := high[len] > upper ? 0 : low[len] < lower ? 1 : os[1]
    top = os == 0 and os[1] != 0 ? high[len] : 0
    btm = os == 1 and os[1] != 1 ? low[len] : 0
    [top, btm]

get_pc_diff_abs(x_start, y_end) =>
    math.abs((y_end - x_start) / x_start * 100)

get_amount_by_pc(amount, pc, add_minus) =>
    pc_amount = amount * (pc / 100)
    add_minus == "add" ? amount + pc_amount : amount - pc_amount

_haBody() =>
    haClose = (open + high + low + close) / 4
    haOpen = float(na)
    haOpen := na(haOpen[1]) ? (open + close) / 2 : (nz(haOpen[1]) + nz(haClose[1])) / 2
    [haOpen, haClose]

// =============================================================================
// LEAN CORE — 5m STRUCTURE STATE
// Same swing sources, close-cross rules, break locks, and confluence formula as
// the full v4 master. Presentation and OB drawing side effects are omitted.
// =============================================================================

[top, btm] = swings(length)
[itop, ibtm] = swings(5)

var float top_y = 0.0
var float btm_y = 0.0
var float itop_y = 0.0
var float ibtm_y = 0.0
var bool top_cross = true
var bool btm_cross = true
var bool itop_cross = true
var bool ibtm_cross = true
var int trend = 0
var int itrend = 0

bull_ichoch_alert = false
bear_ichoch_alert = false
bull_choch_alert = false
bear_choch_alert = false

if top
    top_cross := true
    top_y := top
if btm
    btm_cross := true
    btm_y := btm
if itop
    itop_cross := true
    itop_y := itop
if ibtm
    ibtm_cross := true
    ibtm_y := ibtm

bull_concordant = true
if ifilter_confluence
    bull_concordant := high - math.max(close, open) > math.min(close, open - low)

if ta.crossover(close, itop_y) and itop_cross and top_y != itop_y and bull_concordant
    if itrend < 0
        bull_ichoch_alert := true
    itop_cross := false
    itrend := 1

if ta.crossover(close, top_y) and top_cross
    if trend < 0
        bull_choch_alert := true
    top_cross := false
    trend := 1

bear_concordant = true
if ifilter_confluence
    bear_concordant := high - math.max(close, open) < math.min(close, open - low)

if ta.crossunder(close, ibtm_y) and ibtm_cross and btm_y != ibtm_y and bear_concordant
    if itrend > 0
        bear_ichoch_alert := true
    ibtm_cross := false
    itrend := -1

if ta.crossunder(close, btm_y) and btm_cross
    if trend > 0
        bear_choch_alert := true
    btm_cross := false
    trend := -1

// =============================================================================
// LEAN CORE — 5m PIVOT S/R REACTION STATE
// Numeric replacement for the original box-backed engine. It retains pivot
// source, geometry, alignment, polarity flips, and reaction formulas.
// =============================================================================

[leanHaOpen, leanHaClose] = _haBody()
leanSrcHigh = src == "HA" ? math.max(leanHaOpen, leanHaClose) : src == "High/Low" ? high : math.max(close, open)
leanSrcLow = src == "HA" ? math.min(leanHaOpen, leanHaClose) : src == "High/Low" ? low : math.min(close, open)
leanPivotHigh = ta.pivothigh(leanSrcHigh, left, right)
leanPivotLow = ta.pivotlow(leanSrcLow, left, right)
leanPivotAtr = ta.atr(atrLen)
leanBand = math.min(leanPivotAtr * mult, close * (per / 100))[right] / 2

var float[] leanHighTop = array.new_float(nPiv)
var float[] leanHighBottom = array.new_float(nPiv)
var bool[] leanHighBull = array.new_bool(nPiv)
var float[] leanLowTop = array.new_float(nPiv)
var float[] leanLowBottom = array.new_float(nPiv)
var bool[] leanLowBull = array.new_bool(nPiv)

lean_load_zone(_tops, _bottoms, _states, _top, _bottom, _bullish) =>
    array.unshift(_tops, _top)
    array.unshift(_bottoms, _bottom)
    array.unshift(_states, _bullish)
    if array.size(_tops) > nPiv
        array.pop(_tops)
        array.pop(_bottoms)
        array.pop(_states)

lean_align_zones(_sourceTops, _sourceBottoms, _targetTops, _targetBottoms) =>
    if array.size(_targetTops) > 0
        for _zoneIndex = 0 to array.size(_sourceTops) - 1
            _targetTop = array.get(_targetTops, 0)
            _targetBottom = array.get(_targetBottoms, 0)
            _sourceTop = array.get(_sourceTops, _zoneIndex)
            _sourceBottom = array.get(_sourceBottoms, _zoneIndex)
            _overlaps = (_targetTop > _sourceBottom and _targetTop < _sourceTop) or
              (_targetBottom < _sourceTop and _targetBottom > _sourceBottom) or
              (_targetTop > _sourceTop and _targetBottom < _sourceBottom) or
              (_targetBottom > _sourceBottom and _targetTop < _sourceTop)
            if _overlaps
                array.set(_targetTops, 0, _sourceTop)
                array.set(_targetBottoms, 0, _sourceBottom)

lean_color_zones(_tops, _bottoms, _states) =>
    var int _track = nPiv
    for _zoneIndex = 0 to array.size(_tops) - 1
        _zoneTop = array.get(_tops, _zoneIndex)
        _zoneBottom = array.get(_bottoms, _zoneIndex)
        _isBull = array.get(_states, _zoneIndex)
        if close > _zoneTop and not _isBull
            array.set(_states, _zoneIndex, true)
            _track += 1
        if close < _zoneBottom and _isBull
            array.set(_states, _zoneIndex, false)
            _track -= 1
    _track

lean_detect_zone(_tops, _bottoms, _states) =>
    int _zoneIndex = 0
    bool _found = false
    bool _isBull = na
    while not _found and _zoneIndex < array.size(_tops)
        _zoneTop = array.get(_tops, _zoneIndex)
        _zoneBottom = array.get(_bottoms, _zoneIndex)
        if low < _zoneTop and high > _zoneBottom
            _isBull := array.get(_states, _zoneIndex)
            _found := true
        _zoneIndex += 1
    [_found, _isBull]

lean_num_levels(_highStates, _lowStates) =>
    int _above = 0
    int _fill = 0
    for _zoneIndex = 0 to array.size(_highStates) - 1
        _isBull = array.get(_highStates, _zoneIndex)
        if _isBull
            _above += 1
        if not na(_isBull)
            _fill += 1
    for _zoneIndex = 0 to array.size(_lowStates) - 1
        _isBull = array.get(_lowStates, _zoneIndex)
        if _isBull
            _above += 1
        if not na(_isBull)
            _fill += 1
    [_above, _fill]

if leanPivotHigh and dhighs and barstate.isconfirmed
    lean_load_zone(leanHighTop, leanHighBottom, leanHighBull, leanPivotHigh + leanBand, leanPivotHigh - leanBand, false)

if leanPivotLow and dlows and barstate.isconfirmed
    lean_load_zone(leanLowTop, leanLowBottom, leanLowBull, leanPivotLow + leanBand, leanPivotLow - leanBand, true)

if alignZones
    lean_align_zones(leanHighTop, leanHighBottom, leanHighTop, leanHighBottom)
    lean_align_zones(leanHighTop, leanHighBottom, leanLowTop, leanLowBottom)
    lean_align_zones(leanLowTop, leanLowBottom, leanLowTop, leanLowBottom)
    lean_align_zones(leanLowTop, leanLowBottom, leanHighTop, leanHighBottom)

trackHigh = lean_color_zones(leanHighTop, leanHighBottom, leanHighBull)
trackLows = lean_color_zones(leanLowTop, leanLowBottom, leanLowBull)

closeLows = ta.lowest(close, 5)
closeHigh = ta.highest(close, 5)
isLows = closeLows == close
isHigh = closeHigh == close

lean_check(_condition, _lookback) =>
    bool _result = false
    for _index = 0 to _lookback
        if _condition[_index]
            _result := true
    _result

wasLows = lean_check(isLows, 2)
wasHigh = lean_check(isHigh, 2)
[above, total] = lean_num_levels(leanHighBull, leanLowBull)
moveAbove = trackHigh > trackHigh[1]
moveBelow = trackLows < trackLows[1]
resBreak = trackLows > trackLows[1] or moveAbove
supBreak = trackHigh < trackHigh[1] or moveBelow
[fh, hb] = lean_detect_zone(leanHighTop, leanHighBottom, leanHighBull)
[fl, lb] = lean_detect_zone(leanLowTop, leanLowBottom, leanLowBull)
bullCheck = not resBreak and not resBreak[1] and (fh or fl) and close > open and (hb or lb)
bearCheck = not supBreak and not supBreak[1] and (fh or fl) and close < open and not (hb or lb)

// Keep these calculations explicit even though false-break and pattern drawings
// are presentation-only and intentionally absent from the lean core.
leanHighest = close == ta.highest(close, right)
leanLowest = close == ta.lowest(close, right)
leanBreakOut = moveAbove and leanHighest and above == total
leanBreakDown = moveBelow and leanLowest and above == 0
leanWasLows = wasLows
leanWasHigh = wasHigh

// =============================================================================
// LEAN CORE — NINE DASHBOARD STATES, BULB CONTEXT, ATR(89)
// Formulas and directional comparisons match the full v4 master.
// =============================================================================

fisherHigh = ta.highest(hl2, fisherLength)
fisherLow = ta.lowest(hl2, fisherLength)
lean_round_fisher(_value) => _value > 0.99 ? 0.999 : _value < -0.99 ? -0.999 : _value
fisherValue = 0.0
fisherValue := lean_round_fisher(0.66 * ((hl2 - fisherLow) / (fisherHigh - fisherLow) - 0.5) + 0.67 * nz(fisherValue[1]))
fish1 = 0.0
fish1 := 0.5 * math.log((1 + fisherValue) / (1 - fisherValue)) + 0.5 * nz(fish1[1])
fish2 = fish1[1]

dashboardRsiSource = ta.rsi(close, lengthRSI)
k = ta.sma(ta.stoch(dashboardRsiSource, dashboardRsiSource, dashboardRsiSource, lengthStoch), smoothK)
d = ta.sma(k, smoothD)
vmp = math.sum(math.abs(high - low[1]), vortexLength)
vmm = math.sum(math.abs(low - high[1]), vortexLength)
vortexTrueRange = math.sum(ta.atr(1), vortexLength)
VIP = vmp / vortexTrueRange
VIM = vmm / vortexTrueRange
[diplus, diminus, leanAdx] = ta.dmi(dmiLength, dmiSmooth)
psar = ta.sar(psarStart, psarInc, psarMax)
mom = ta.mom(close, momLength)
mfi = ta.mfi(close, mfiLength)
rsi = ta.rsi(close, rsiLength)
[macdLine, signalLine, leanHistLine] = ta.macd(close, macdFast, macdSlow, macdSignal)

macdLabel = macdLine > signalLine ? color.lime : macdLine < signalLine ? color.red : color.blue
stochLabel = k > d ? color.lime : k < d ? color.red : color.blue
vortexLabel = VIP > VIM ? color.lime : VIP < VIM ? color.red : color.blue
mfiLabel = mfi > mfi[1] ? color.lime : mfi < mfi[1] ? color.red : color.blue
fisherLabel = fish1 > fish2 ? color.lime : fish1 < fish2 ? color.red : color.blue
dmiLabel = diplus > diminus ? color.lime : diplus < diminus ? color.red : color.blue
momLabel = mom > mom[1] ? color.lime : mom < mom[1] ? color.red : color.blue
psarLabel = close > psar ? color.lime : close < psar ? color.red : color.blue
rsiLabel = rsi > rsi[1] ? color.lime : rsi < rsi[1] ? color.red : color.blue

rsiValue = ta.rsi(close, 13)
isOverbought = rsiValue >= 65
isOversold = rsiValue <= 30
atrv = ta.atr(89)

// PHASE 5 — MULTI-TIMEFRAME STATE ARCHITECTURE
// Collects and normalizes confirmed information only. It does not score setups,
// create trade signals, lock AOIs, calculate stops/targets, or place trades.
// =============================================================================

// -----------------------------------------------------------------------------
// PHASE 5 / PIECE 1 OF 8 — MTF Timeframe Controller
// -----------------------------------------------------------------------------
phase5MacroTf = input.timeframe('240', 'Macro TF', options=['240'], group='Phase 5 — MTF Controller')
phase5BiasTf = input.timeframe('60', 'Bias TF', options=['60'], group='Phase 5 — MTF Controller')
phase5SetupTf = input.timeframe('15', 'Setup TF', options=['15'], group='Phase 5 — MTF Controller')
phase5ExecutionTf = input.timeframe('5', 'Execution TF', options=['5'], group='Phase 5 — MTF Controller')
phase5SetupHistoryBars = input.int(500, '15m setup history bars', minval=500, maxval=5000, group='Phase 5 — MTF Controller', tooltip='Limits the 15m Phase 5 request history to protect TradingView memory. Increase cautiously only after confirming runtime stability.')
phase5ActiveCandidateCap = input.int(100, 'Active candidate safety cap', minval=25, maxval=500, group='Phase 5 — MTF Controller', tooltip='Maximum active 15m candidates retained per AOI type before the oldest active candidate is removed for runtime safety. Phase 5 still publishes the nearest three from the retained pool.')
phase5ExecutionTfOk = timeframe.period == phase5ExecutionTf
phase5TfHierarchyOk = timeframe.in_seconds(phase5MacroTf) > timeframe.in_seconds(phase5BiasTf) and
  timeframe.in_seconds(phase5BiasTf) > timeframe.in_seconds(phase5SetupTf) and
  timeframe.in_seconds(phase5SetupTf) > timeframe.in_seconds(phase5ExecutionTf)

// -----------------------------------------------------------------------------
// PHASE 5 / PIECE 2 OF 8 — Safe / Confirmed MTF Data Layer
// The one-bar offset plus lookahead_on returns only the last closed source-TF bar.
// State packet functions below apply the same offset before transport.
// -----------------------------------------------------------------------------
phase5_confirmed_ohlc(_tf) =>
    request.security(syminfo.tickerid, _tf, [open[1], high[1], low[1], close[1], time[1]], lookahead=barmerge.lookahead_on)

phase5_confirmed_previous_hl(_tf) =>
    request.security(syminfo.tickerid, _tf, [high[1], low[1]], lookahead=barmerge.lookahead_on)

// Uses the last confirmed swing boundaries by design. This is stable Master-Brain
// context and is separate from the original chart boxes' live trail_up/trail_dn range.
phase5_range_location(_price, _rangeHigh, _rangeLow) =>
    int _location = 9
    if not na(_rangeHigh) and not na(_rangeLow) and _rangeHigh > _rangeLow
        _premiumFloor = 0.95 * _rangeHigh + 0.05 * _rangeLow
        _equilibriumHigh = 0.525 * _rangeHigh + 0.475 * _rangeLow
        _equilibriumLow = 0.525 * _rangeLow + 0.475 * _rangeHigh
        _discountCeiling = 0.95 * _rangeLow + 0.05 * _rangeHigh
        _location := _price >= _premiumFloor ? 1 :
          _price <= _discountCeiling ? -1 :
          _price <= _equilibriumHigh and _price >= _equilibriumLow ? 0 :
          _price > _equilibriumHigh ? 2 : -2
    _location

phase5_align_zone_arrays(_sourceTop, _sourceBottom, _sourceOrigin, _sourceConfirmed, _sourceFresh, _targetTop, _targetBottom, _targetOrigin, _targetConfirmed, _targetFresh) =>
    if array.size(_targetTop) > 0
        for _zoneIndex = 0 to (array.size(_sourceTop) == 0 ? na : array.size(_sourceTop) - 1)
            _targetZoneTop = array.get(_targetTop, 0)
            _targetZoneBottom = array.get(_targetBottom, 0)
            _sourceZoneTop = array.get(_sourceTop, _zoneIndex)
            _sourceZoneBottom = array.get(_sourceBottom, _zoneIndex)
            _overlaps = (_targetZoneTop > _sourceZoneBottom and _targetZoneTop < _sourceZoneTop) or
              (_targetZoneBottom < _sourceZoneTop and _targetZoneBottom > _sourceZoneBottom) or
              (_targetZoneTop > _sourceZoneTop and _targetZoneBottom < _sourceZoneBottom) or
              (_targetZoneBottom > _sourceZoneBottom and _targetZoneTop < _sourceZoneTop)
            if _overlaps
                array.set(_targetTop, 0, _sourceZoneTop)
                array.set(_targetBottom, 0, _sourceZoneBottom)
                array.set(_targetOrigin, 0, math.min(array.get(_targetOrigin, 0), array.get(_sourceOrigin, _zoneIndex)))
                array.set(_targetConfirmed, 0, math.max(array.get(_targetConfirmed, 0), array.get(_sourceConfirmed, _zoneIndex)))
                array.set(_targetFresh, 0, array.get(_targetFresh, 0) and array.get(_sourceFresh, _zoneIndex))

phase5_three_candidates(_tops, _bottoms, _originTimes, _confirmedTimes, _freshStates, _distanceMode) =>
    float _top1 = na
    float _bottom1 = na
    int _origin1 = na
    int _confirmed1 = na
    bool _fresh1 = false
    float _distance1 = na
    float _top2 = na
    float _bottom2 = na
    int _origin2 = na
    int _confirmed2 = na
    bool _fresh2 = false
    float _distance2 = na
    float _top3 = na
    float _bottom3 = na
    int _origin3 = na
    int _confirmed3 = na
    bool _fresh3 = false
    float _distance3 = na
    for _candidateIndex = 0 to (array.size(_tops) == 0 ? na : array.size(_tops) - 1)
        _candidateTop = array.get(_tops, _candidateIndex)
        _candidateBottom = array.get(_bottoms, _candidateIndex)
        _candidateOrigin = array.get(_originTimes, _candidateIndex)
        _candidateConfirmed = array.get(_confirmedTimes, _candidateIndex)
        _candidateFresh = array.get(_freshStates, _candidateIndex)
        _candidatePrice = _distanceMode == 1 ? _candidateTop : _distanceMode == -1 ? _candidateBottom : math.avg(_candidateTop, _candidateBottom)
        _candidateDistance = math.abs(close - _candidatePrice)
        if na(_distance1) or _candidateDistance < _distance1
            _top3 := _top2
            _bottom3 := _bottom2
            _origin3 := _origin2
            _confirmed3 := _confirmed2
            _fresh3 := _fresh2
            _distance3 := _distance2
            _top2 := _top1
            _bottom2 := _bottom1
            _origin2 := _origin1
            _confirmed2 := _confirmed1
            _fresh2 := _fresh1
            _distance2 := _distance1
            _top1 := _candidateTop
            _bottom1 := _candidateBottom
            _origin1 := _candidateOrigin
            _confirmed1 := _candidateConfirmed
            _fresh1 := _candidateFresh
            _distance1 := _candidateDistance
        else if na(_distance2) or _candidateDistance < _distance2
            _top3 := _top2
            _bottom3 := _bottom2
            _origin3 := _origin2
            _confirmed3 := _confirmed2
            _fresh3 := _fresh2
            _distance3 := _distance2
            _top2 := _candidateTop
            _bottom2 := _candidateBottom
            _origin2 := _candidateOrigin
            _confirmed2 := _candidateConfirmed
            _fresh2 := _candidateFresh
            _distance2 := _candidateDistance
        else if na(_distance3) or _candidateDistance < _distance3
            _top3 := _candidateTop
            _bottom3 := _candidateBottom
            _origin3 := _candidateOrigin
            _confirmed3 := _candidateConfirmed
            _fresh3 := _candidateFresh
            _distance3 := _candidateDistance
    [_top1, _bottom1, _origin1, _confirmed1, _fresh1,
      _top2, _bottom2, _origin2, _confirmed2, _fresh2,
      _top3, _bottom3, _origin3, _confirmed3, _fresh3]

phase5_three_liquidity_levels(_levels, _originTimes, _confirmedTimes, _abovePrice) =>
    float _level1 = na
    int _origin1 = na
    int _confirmed1 = na
    float _distance1 = na
    float _level2 = na
    int _origin2 = na
    int _confirmed2 = na
    float _distance2 = na
    float _level3 = na
    int _origin3 = na
    int _confirmed3 = na
    float _distance3 = na
    for _candidateIndex = 0 to (array.size(_levels) == 0 ? na : array.size(_levels) - 1)
        _candidateLevel = array.get(_levels, _candidateIndex)
        _eligible = _abovePrice ? _candidateLevel > close : _candidateLevel < close
        if _eligible
            _candidateOrigin = array.get(_originTimes, _candidateIndex)
            _candidateConfirmed = array.get(_confirmedTimes, _candidateIndex)
            _candidateDistance = math.abs(close - _candidateLevel)
            if na(_distance1) or _candidateDistance < _distance1
                _level3 := _level2
                _origin3 := _origin2
                _confirmed3 := _confirmed2
                _distance3 := _distance2
                _level2 := _level1
                _origin2 := _origin1
                _confirmed2 := _confirmed1
                _distance2 := _distance1
                _level1 := _candidateLevel
                _origin1 := _candidateOrigin
                _confirmed1 := _candidateConfirmed
                _distance1 := _candidateDistance
            else if na(_distance2) or _candidateDistance < _distance2
                _level3 := _level2
                _origin3 := _origin2
                _confirmed3 := _confirmed2
                _distance3 := _distance2
                _level2 := _candidateLevel
                _origin2 := _candidateOrigin
                _confirmed2 := _candidateConfirmed
                _distance2 := _candidateDistance
            else if na(_distance3) or _candidateDistance < _distance3
                _level3 := _candidateLevel
                _origin3 := _candidateOrigin
                _confirmed3 := _candidateConfirmed
                _distance3 := _candidateDistance
    [_level1, _origin1, _confirmed1, _level2, _origin2, _confirmed2, _level3, _origin3, _confirmed3]

type Phase5ZoneCandidate
    float top
    float bottom
    int origin
    int confirmed
    bool fresh

type Phase5LiquidityCandidate
    float level
    int origin
    int confirmed

type Phase5SetupState
    Phase5ZoneCandidate demand1
    Phase5ZoneCandidate demand2
    Phase5ZoneCandidate demand3
    Phase5ZoneCandidate supply1
    Phase5ZoneCandidate supply2
    Phase5ZoneCandidate supply3
    Phase5ZoneCandidate bullOb1
    Phase5ZoneCandidate bullOb2
    Phase5ZoneCandidate bullOb3
    Phase5ZoneCandidate bearOb1
    Phase5ZoneCandidate bearOb2
    Phase5ZoneCandidate bearOb3
    Phase5ZoneCandidate bullFvg1
    Phase5ZoneCandidate bullFvg2
    Phase5ZoneCandidate bullFvg3
    Phase5ZoneCandidate bearFvg1
    Phase5ZoneCandidate bearFvg2
    Phase5ZoneCandidate bearFvg3
    Phase5ZoneCandidate pivotSupport1
    Phase5ZoneCandidate pivotSupport2
    Phase5ZoneCandidate pivotSupport3
    Phase5ZoneCandidate pivotResistance1
    Phase5ZoneCandidate pivotResistance2
    Phase5ZoneCandidate pivotResistance3
    Phase5LiquidityCandidate eqh1
    Phase5LiquidityCandidate eqh2
    Phase5LiquidityCandidate eqh3
    Phase5LiquidityCandidate eql1
    Phase5LiquidityCandidate eql2
    Phase5LiquidityCandidate eql3
    int location
    float rangeHigh
    float rangeLow

// request.security() can return an undefined UDT on the chart's earliest bars
// before the source-timeframe packet has a completed value. Keep the public
// interface safe during that initialization window without inventing state.
phase5_empty_setup_state() =>
    _emptyZone = Phase5ZoneCandidate.new(na, na, na, na, false)
    _emptyLiquidity = Phase5LiquidityCandidate.new(na, na, na)
    Phase5SetupState.new(
      _emptyZone, _emptyZone, _emptyZone,
      _emptyZone, _emptyZone, _emptyZone,
      _emptyZone, _emptyZone, _emptyZone,
      _emptyZone, _emptyZone, _emptyZone,
      _emptyZone, _emptyZone, _emptyZone,
      _emptyZone, _emptyZone, _emptyZone,
      _emptyZone, _emptyZone, _emptyZone,
      _emptyZone, _emptyZone, _emptyZone,
      _emptyLiquidity, _emptyLiquidity, _emptyLiquidity,
      _emptyLiquidity, _emptyLiquidity, _emptyLiquidity,
      9, na, na)

phase5_structure_packet(_swingLength) =>
    [_swingHigh, _swingLow] = swings(_swingLength)

    var float _lastHigh = na
    var float _lastLow = na
    var int _state = 0
    var int _lastBreakDirection = 0
    var bool _highCanBreak = true
    var bool _lowCanBreak = true

    if _swingHigh != 0
        _lastHigh := _swingHigh
        _highCanBreak := true
    if _swingLow != 0
        _lastLow := _swingLow
        _lowCanBreak := true

    _bullBreak = not na(_lastHigh) and _highCanBreak and ta.crossover(close, _lastHigh)
    _bearBreak = not na(_lastLow) and _lowCanBreak and ta.crossunder(close, _lastLow)

    if _bullBreak
        _state := 1
        _lastBreakDirection := 1
        _highCanBreak := false
    else if _bearBreak
        _state := -1
        _lastBreakDirection := -1
        _lowCanBreak := false

    _location = phase5_range_location(close, _lastHigh, _lastLow)
    [_state[1], _lastHigh[1], _lastLow[1], _lastBreakDirection[1], _location[1]]

phase5_setup_packet() =>
    _atr200 = ta.atr(200)
    _meanRange = ta.cum(high - low) / math.max(bar_index, 1)
    _obThreshold = ob_filter == 'Atr' ? _atr200 : _meanRange

    // Demand/Supply adapter — same displacement/base concept, data only.
    _bearRun = ta.barssince(open < close)
    _bullRun = ta.barssince(open > close)
    var float _s1Level = na
    var int _s1Time = na
    _smallBase = get_pc_diff_abs(open[1], close[1]) < 0.02
    _s1Level := _smallBase and ((_bullRun == 1 and open[2] > close[2]) or (_bearRun == 1 and open[2] < close[2])) ? open[2] :
      _bullRun == 1 or _bearRun == 1 ? open[1] :
      _bullRun > 1 or _bearRun > 1 ? _s1Level : na
    _s1Time := _bullRun == 1 or _bearRun == 1 ? time[1] :
      _bullRun > 1 or _bearRun > 1 ? _s1Time : na

    var float[] _demandTops = array.new_float()
    var float[] _demandBottoms = array.new_float()
    var int[] _demandOrigin = array.new_int()
    var int[] _demandConfirmed = array.new_int()
    var bool[] _demandFresh = array.new_bool()
    var float[] _supplyTops = array.new_float()
    var float[] _supplyBottoms = array.new_float()
    var int[] _supplyOrigin = array.new_int()
    var int[] _supplyConfirmed = array.new_int()
    var bool[] _supplyFresh = array.new_bool()

    _i = array.size(_demandTops) - 1
    while _i >= 0
        if time >= array.get(_demandConfirmed, _i) and low <= array.get(_demandTops, _i)
            array.remove(_demandTops, _i)
            array.remove(_demandBottoms, _i)
            array.remove(_demandOrigin, _i)
            array.remove(_demandConfirmed, _i)
            array.remove(_demandFresh, _i)
        _i -= 1

    _i := array.size(_supplyTops) - 1
    while _i >= 0
        if time >= array.get(_supplyConfirmed, _i) and high >= array.get(_supplyBottoms, _i)
            array.remove(_supplyTops, _i)
            array.remove(_supplyBottoms, _i)
            array.remove(_supplyOrigin, _i)
            array.remove(_supplyConfirmed, _i)
            array.remove(_supplyFresh, _i)
        _i -= 1

    _demandBars = _bullRun
    _validDemandBars = not na(_demandBars) and _demandBars >= 1 and _demandBars < 500
    _demandChange = _validDemandBars ? get_pc_diff_abs(close, open[_demandBars - 1]) : 0.0
    _newDemand = _validDemandBars and not na(_s1Time) and not array.includes(_demandOrigin, _s1Time) and _demandChange >= ds_min_pc_change
    if _newDemand
        _demandTop = _s1Level
        _demandBot = math.min(low[_demandBars], low[_demandBars - 1])
        _demandHeight = get_pc_diff_abs(_demandTop, _demandBot)
        _baseCandleChange = get_pc_diff_abs(open[_demandBars], close[_demandBars])
        _demandBot := _demandHeight > ds_max_pc_zone ? get_amount_by_pc(_demandTop, ds_max_pc_zone, 'minus') : _demandBot
        _demandTop := _demandHeight > ds_max_pc_zone and _baseCandleChange <= ds_max_pc_zone ? _s1Level :
          _demandHeight > ds_max_pc_zone ? get_amount_by_pc(close[_demandBars], ds_max_pc_zone / 5, 'add') : _demandTop
        _demandTop := math.round_to_mintick(_demandTop)
        _demandBot := math.round_to_mintick(_demandBot)
        // Preserve the Phase 5 zone contract after independent size adjustments:
        // Top is always the higher boundary and Bottom is always the lower one.
        _demandHigh = math.max(_demandTop, _demandBot)
        _demandLow = math.min(_demandTop, _demandBot)
        _demandTop := _demandHigh
        _demandBot := _demandLow
        array.unshift(_demandTops, _demandTop)
        array.unshift(_demandBottoms, _demandBot)
        array.unshift(_demandOrigin, _s1Time)
        array.unshift(_demandConfirmed, time_close)
        array.unshift(_demandFresh, true)

    _supplyBars = _bearRun
    _validSupplyBars = not na(_supplyBars) and _supplyBars >= 1 and _supplyBars < 500
    _supplyChange = _validSupplyBars ? get_pc_diff_abs(close, open[_supplyBars - 1]) : 0.0
    _newSupply = _validSupplyBars and not na(_s1Time) and not array.includes(_supplyOrigin, _s1Time) and _supplyChange >= ds_min_pc_change
    if _newSupply
        _supplyTop = math.max(high[_supplyBars], high[_supplyBars - 1])
        _supplyBot = _s1Level
        _supplyHeight = get_pc_diff_abs(_supplyTop, _supplyBot)
        _baseCandleChange = get_pc_diff_abs(open[_supplyBars], close[_supplyBars])
        _supplyBot := _supplyHeight > ds_max_pc_zone and _baseCandleChange <= ds_max_pc_zone ? _s1Level :
          _supplyHeight > ds_max_pc_zone ? get_amount_by_pc(close[_supplyBars], ds_max_pc_zone / 5, 'minus') : _supplyBot
        _supplyTop := _supplyHeight > ds_max_pc_zone ? get_amount_by_pc(_supplyBot, ds_max_pc_zone, 'add') : _supplyTop
        _supplyTop := math.round_to_mintick(_supplyTop)
        _supplyBot := math.round_to_mintick(_supplyBot)
        // Apply the same defensive boundary contract to Supply candidates.
        _supplyHigh = math.max(_supplyTop, _supplyBot)
        _supplyLow = math.min(_supplyTop, _supplyBot)
        _supplyTop := _supplyHigh
        _supplyBot := _supplyLow
        array.unshift(_supplyTops, _supplyTop)
        array.unshift(_supplyBottoms, _supplyBot)
        array.unshift(_supplyOrigin, _s1Time)
        array.unshift(_supplyConfirmed, time_close)
        array.unshift(_supplyFresh, true)

    if array.size(_demandTops) > phase5ActiveCandidateCap
        array.pop(_demandTops)
        array.pop(_demandBottoms)
        array.pop(_demandOrigin)
        array.pop(_demandConfirmed)
        array.pop(_demandFresh)
    if array.size(_supplyTops) > phase5ActiveCandidateCap
        array.pop(_supplyTops)
        array.pop(_supplyBottoms)
        array.pop(_supplyOrigin)
        array.pop(_supplyConfirmed)
        array.pop(_supplyFresh)

    [_demand1Top, _demand1Bottom, _demand1Origin, _demand1Confirmed, _demand1Fresh,
      _demand2Top, _demand2Bottom, _demand2Origin, _demand2Confirmed, _demand2Fresh,
      _demand3Top, _demand3Bottom, _demand3Origin, _demand3Confirmed, _demand3Fresh] =
      phase5_three_candidates(_demandTops, _demandBottoms, _demandOrigin, _demandConfirmed, _demandFresh, 1)
    [_supply1Top, _supply1Bottom, _supply1Origin, _supply1Confirmed, _supply1Fresh,
      _supply2Top, _supply2Bottom, _supply2Origin, _supply2Confirmed, _supply2Fresh,
      _supply3Top, _supply3Bottom, _supply3Origin, _supply3Confirmed, _supply3Fresh] =
      phase5_three_candidates(_supplyTops, _supplyBottoms, _supplyOrigin, _supplyConfirmed, _supplyFresh, -1)

    // Swing Order Block adapter — exact original SMC swing source and break lock.
    [_swingTop, _swingBottom] = swings(length)
    var float _lastSwingHigh = na
    var float _lastSwingLow = na
    var int _lastSwingHighBar = na
    var int _lastSwingLowBar = na
    var bool _swingHighCanBreak = true
    var bool _swingLowCanBreak = true
    if _swingTop != 0
        _lastSwingHigh := _swingTop
        _lastSwingHighBar := bar_index - length
        _swingHighCanBreak := true
    if _swingBottom != 0
        _lastSwingLow := _swingBottom
        _lastSwingLowBar := bar_index - length
        _swingLowCanBreak := true

    var float[] _bullObTop = array.new_float()
    var float[] _bullObBottom = array.new_float()
    var int[] _bullObOrigin = array.new_int()
    var int[] _bullObConfirmed = array.new_int()
    var bool[] _bullObFresh = array.new_bool()
    var float[] _bearObTop = array.new_float()
    var float[] _bearObBottom = array.new_float()
    var int[] _bearObOrigin = array.new_int()
    var int[] _bearObConfirmed = array.new_int()
    var bool[] _bearObFresh = array.new_bool()

    _i := array.size(_bullObTop) - 1
    while _i >= 0
        if close < array.get(_bullObBottom, _i)
            array.remove(_bullObTop, _i)
            array.remove(_bullObBottom, _i)
            array.remove(_bullObOrigin, _i)
            array.remove(_bullObConfirmed, _i)
            array.remove(_bullObFresh, _i)
        _i -= 1

    _i := array.size(_bearObTop) - 1
    while _i >= 0
        if close > array.get(_bearObTop, _i)
            array.remove(_bearObTop, _i)
            array.remove(_bearObBottom, _i)
            array.remove(_bearObOrigin, _i)
            array.remove(_bearObConfirmed, _i)
            array.remove(_bearObFresh, _i)
        _i -= 1

    for _zoneIndex = 0 to (array.size(_bullObTop) == 0 ? na : array.size(_bullObTop) - 1)
        _touched = time >= array.get(_bullObConfirmed, _zoneIndex) and
          high >= array.get(_bullObBottom, _zoneIndex) and low <= array.get(_bullObTop, _zoneIndex)
        if _touched
            array.set(_bullObFresh, _zoneIndex, false)

    for _zoneIndex = 0 to (array.size(_bearObTop) == 0 ? na : array.size(_bearObTop) - 1)
        _touched = time >= array.get(_bearObConfirmed, _zoneIndex) and
          high >= array.get(_bearObBottom, _zoneIndex) and low <= array.get(_bearObTop, _zoneIndex)
        if _touched
            array.set(_bearObFresh, _zoneIndex, false)

    _bullStructureBreak = not na(_lastSwingHigh) and _swingHighCanBreak and ta.crossover(close, _lastSwingHigh)
    if _bullStructureBreak and not na(_lastSwingHighBar)
        _scanBars = math.min(bar_index - _lastSwingHighBar - 1, 499)
        float _selectedLow = na
        float _selectedHigh = na
        int _selectedTime = na
        if _scanBars >= 1
            for _scan = 1 to _scanBars
                if high[_scan] - low[_scan] < _obThreshold[_scan] * 2
                    if na(_selectedLow) or low[_scan] < _selectedLow
                        _selectedLow := low[_scan]
                        _selectedHigh := high[_scan]
                        _selectedTime := time[_scan]
        if not na(_selectedLow)
            array.unshift(_bullObTop, _selectedHigh)
            array.unshift(_bullObBottom, _selectedLow)
            array.unshift(_bullObOrigin, _selectedTime)
            array.unshift(_bullObConfirmed, time_close)
            array.unshift(_bullObFresh, true)
        _swingHighCanBreak := false

    _bearStructureBreak = not na(_lastSwingLow) and _swingLowCanBreak and ta.crossunder(close, _lastSwingLow)
    if _bearStructureBreak and not na(_lastSwingLowBar)
        _scanBars = math.min(bar_index - _lastSwingLowBar - 1, 499)
        float _selectedHigh = na
        float _selectedLow = na
        int _selectedTime = na
        if _scanBars >= 1
            for _scan = 1 to _scanBars
                if high[_scan] - low[_scan] < _obThreshold[_scan] * 2
                    if na(_selectedHigh) or high[_scan] > _selectedHigh
                        _selectedHigh := high[_scan]
                        _selectedLow := low[_scan]
                        _selectedTime := time[_scan]
        if not na(_selectedHigh)
            array.unshift(_bearObTop, _selectedHigh)
            array.unshift(_bearObBottom, _selectedLow)
            array.unshift(_bearObOrigin, _selectedTime)
            array.unshift(_bearObConfirmed, time_close)
            array.unshift(_bearObFresh, true)
        _swingLowCanBreak := false

    if array.size(_bullObTop) > phase5ActiveCandidateCap
        array.pop(_bullObTop)
        array.pop(_bullObBottom)
        array.pop(_bullObOrigin)
        array.pop(_bullObConfirmed)
        array.pop(_bullObFresh)
    if array.size(_bearObTop) > phase5ActiveCandidateCap
        array.pop(_bearObTop)
        array.pop(_bearObBottom)
        array.pop(_bearObOrigin)
        array.pop(_bearObConfirmed)
        array.pop(_bearObFresh)

    [_bullOb1Top, _bullOb1Bottom, _bullOb1Origin, _bullOb1Confirmed, _bullOb1Fresh,
      _bullOb2Top, _bullOb2Bottom, _bullOb2Origin, _bullOb2Confirmed, _bullOb2Fresh,
      _bullOb3Top, _bullOb3Bottom, _bullOb3Origin, _bullOb3Confirmed, _bullOb3Fresh] =
      phase5_three_candidates(_bullObTop, _bullObBottom, _bullObOrigin, _bullObConfirmed, _bullObFresh, 1)
    [_bearOb1Top, _bearOb1Bottom, _bearOb1Origin, _bearOb1Confirmed, _bearOb1Fresh,
      _bearOb2Top, _bearOb2Bottom, _bearOb2Origin, _bearOb2Confirmed, _bearOb2Fresh,
      _bearOb3Top, _bearOb3Bottom, _bearOb3Origin, _bearOb3Confirmed, _bearOb3Fresh] =
      phase5_three_candidates(_bearObTop, _bearObBottom, _bearObOrigin, _bearObConfirmed, _bearObFresh, -1)

    // FVG adapter — same three-candle imbalance concept, data only.
    var float[] _bullFvgTop = array.new_float()
    var float[] _bullFvgBottom = array.new_float()
    var int[] _bullFvgOrigin = array.new_int()
    var int[] _bullFvgConfirmed = array.new_int()
    var bool[] _bullFvgFresh = array.new_bool()
    var float[] _bearFvgTop = array.new_float()
    var float[] _bearFvgBottom = array.new_float()
    var int[] _bearFvgOrigin = array.new_int()
    var int[] _bearFvgConfirmed = array.new_int()
    var bool[] _bearFvgFresh = array.new_bool()

    _i := array.size(_bullFvgTop) - 1
    while _i >= 0
        if low < array.get(_bullFvgBottom, _i)
            array.remove(_bullFvgTop, _i)
            array.remove(_bullFvgBottom, _i)
            array.remove(_bullFvgOrigin, _i)
            array.remove(_bullFvgConfirmed, _i)
            array.remove(_bullFvgFresh, _i)
        _i -= 1

    _i := array.size(_bearFvgTop) - 1
    while _i >= 0
        if high > array.get(_bearFvgTop, _i)
            array.remove(_bearFvgTop, _i)
            array.remove(_bearFvgBottom, _i)
            array.remove(_bearFvgOrigin, _i)
            array.remove(_bearFvgConfirmed, _i)
            array.remove(_bearFvgFresh, _i)
        _i -= 1

    for _zoneIndex = 0 to (array.size(_bullFvgTop) == 0 ? na : array.size(_bullFvgTop) - 1)
        _touched = time >= array.get(_bullFvgConfirmed, _zoneIndex) and
          high >= array.get(_bullFvgBottom, _zoneIndex) and low <= array.get(_bullFvgTop, _zoneIndex)
        if _touched
            array.set(_bullFvgFresh, _zoneIndex, false)

    for _zoneIndex = 0 to (array.size(_bearFvgTop) == 0 ? na : array.size(_bearFvgTop) - 1)
        _touched = time >= array.get(_bearFvgConfirmed, _zoneIndex) and
          high >= array.get(_bearFvgBottom, _zoneIndex) and low <= array.get(_bearFvgTop, _zoneIndex)
        if _touched
            array.set(_bearFvgFresh, _zoneIndex, false)

    _deltaPercent = (close[1] - open[1]) / open[1] * 100
    _fvgThreshold = fvg_auto ? ta.cum(math.abs(_deltaPercent)) / math.max(bar_index, 1) * 2 : 0.0
    _newBullFvg = low > high[2] and close[1] > high[2] and _deltaPercent > _fvgThreshold
    _newBearFvg = high < low[2] and close[1] < low[2] and -_deltaPercent > _fvgThreshold
    if _newBullFvg
        array.unshift(_bullFvgTop, low)
        array.unshift(_bullFvgBottom, high[2])
        array.unshift(_bullFvgOrigin, time[1])
        array.unshift(_bullFvgConfirmed, time_close)
        array.unshift(_bullFvgFresh, true)
    if _newBearFvg
        array.unshift(_bearFvgTop, low[2])
        array.unshift(_bearFvgBottom, high)
        array.unshift(_bearFvgOrigin, time[1])
        array.unshift(_bearFvgConfirmed, time_close)
        array.unshift(_bearFvgFresh, true)

    if array.size(_bullFvgTop) > phase5ActiveCandidateCap
        array.pop(_bullFvgTop)
        array.pop(_bullFvgBottom)
        array.pop(_bullFvgOrigin)
        array.pop(_bullFvgConfirmed)
        array.pop(_bullFvgFresh)
    if array.size(_bearFvgTop) > phase5ActiveCandidateCap
        array.pop(_bearFvgTop)
        array.pop(_bearFvgBottom)
        array.pop(_bearFvgOrigin)
        array.pop(_bearFvgConfirmed)
        array.pop(_bearFvgFresh)

    [_bullFvg1Top, _bullFvg1Bottom, _bullFvg1Origin, _bullFvg1Confirmed, _bullFvg1Fresh,
      _bullFvg2Top, _bullFvg2Bottom, _bullFvg2Origin, _bullFvg2Confirmed, _bullFvg2Fresh,
      _bullFvg3Top, _bullFvg3Bottom, _bullFvg3Origin, _bullFvg3Confirmed, _bullFvg3Fresh] =
      phase5_three_candidates(_bullFvgTop, _bullFvgBottom, _bullFvgOrigin, _bullFvgConfirmed, _bullFvgFresh, 0)
    [_bearFvg1Top, _bearFvg1Bottom, _bearFvg1Origin, _bearFvg1Confirmed, _bearFvg1Fresh,
      _bearFvg2Top, _bearFvg2Bottom, _bearFvg2Origin, _bearFvg2Confirmed, _bearFvg2Fresh,
      _bearFvg3Top, _bearFvg3Bottom, _bearFvg3Origin, _bearFvg3Confirmed, _bearFvg3Fresh] =
      phase5_three_candidates(_bearFvgTop, _bearFvgBottom, _bearFvgOrigin, _bearFvgConfirmed, _bearFvgFresh, 0)

    // Pivot S/R adapter — configured source, sizing, alignment, and polarity flips.
    [_setupHaOpen, _setupHaClose] = _haBody()
    _setupSourceHigh = src == 'HA' ? math.max(_setupHaOpen, _setupHaClose) : src == 'High/Low' ? high : math.max(open, close)
    _setupSourceLow = src == 'HA' ? math.min(_setupHaOpen, _setupHaClose) : src == 'High/Low' ? low : math.min(open, close)
    _setupPivotHigh = ta.pivothigh(_setupSourceHigh, left, right)
    _setupPivotLow = ta.pivotlow(_setupSourceLow, left, right)
    _setupPivotAtr = ta.atr(atrLen)
    _setupBand = math.min(_setupPivotAtr * mult, close * (per / 100))[right] / 2

    var float[] _pivotHighTops = array.new_float()
    var float[] _pivotHighBottoms = array.new_float()
    var bool[] _pivotHighBullish = array.new_bool()
    var int[] _pivotHighOrigin = array.new_int()
    var int[] _pivotHighConfirmed = array.new_int()
    var bool[] _pivotHighFresh = array.new_bool()
    var float[] _pivotLowTops = array.new_float()
    var float[] _pivotLowBottoms = array.new_float()
    var bool[] _pivotLowBullish = array.new_bool()
    var int[] _pivotLowOrigin = array.new_int()
    var int[] _pivotLowConfirmed = array.new_int()
    var bool[] _pivotLowFresh = array.new_bool()
    _pivotRetention = math.min(phase5ActiveCandidateCap, math.max(nPiv, 3))

    if not na(_setupPivotHigh) and dhighs
        array.unshift(_pivotHighTops, _setupPivotHigh + _setupBand)
        array.unshift(_pivotHighBottoms, _setupPivotHigh - _setupBand)
        array.unshift(_pivotHighBullish, false)
        array.unshift(_pivotHighOrigin, time[right])
        array.unshift(_pivotHighConfirmed, time_close)
        array.unshift(_pivotHighFresh, true)
        if array.size(_pivotHighTops) > _pivotRetention
            array.pop(_pivotHighTops)
            array.pop(_pivotHighBottoms)
            array.pop(_pivotHighBullish)
            array.pop(_pivotHighOrigin)
            array.pop(_pivotHighConfirmed)
            array.pop(_pivotHighFresh)

    if not na(_setupPivotLow) and dlows
        array.unshift(_pivotLowTops, _setupPivotLow + _setupBand)
        array.unshift(_pivotLowBottoms, _setupPivotLow - _setupBand)
        array.unshift(_pivotLowBullish, true)
        array.unshift(_pivotLowOrigin, time[right])
        array.unshift(_pivotLowConfirmed, time_close)
        array.unshift(_pivotLowFresh, true)
        if array.size(_pivotLowTops) > _pivotRetention
            array.pop(_pivotLowTops)
            array.pop(_pivotLowBottoms)
            array.pop(_pivotLowBullish)
            array.pop(_pivotLowOrigin)
            array.pop(_pivotLowConfirmed)
            array.pop(_pivotLowFresh)

    if alignZones
        phase5_align_zone_arrays(_pivotHighTops, _pivotHighBottoms, _pivotHighOrigin, _pivotHighConfirmed, _pivotHighFresh, _pivotHighTops, _pivotHighBottoms, _pivotHighOrigin, _pivotHighConfirmed, _pivotHighFresh)
        phase5_align_zone_arrays(_pivotHighTops, _pivotHighBottoms, _pivotHighOrigin, _pivotHighConfirmed, _pivotHighFresh, _pivotLowTops, _pivotLowBottoms, _pivotLowOrigin, _pivotLowConfirmed, _pivotLowFresh)
        phase5_align_zone_arrays(_pivotLowTops, _pivotLowBottoms, _pivotLowOrigin, _pivotLowConfirmed, _pivotLowFresh, _pivotLowTops, _pivotLowBottoms, _pivotLowOrigin, _pivotLowConfirmed, _pivotLowFresh)
        phase5_align_zone_arrays(_pivotLowTops, _pivotLowBottoms, _pivotLowOrigin, _pivotLowConfirmed, _pivotLowFresh, _pivotHighTops, _pivotHighBottoms, _pivotHighOrigin, _pivotHighConfirmed, _pivotHighFresh)

    for _zoneIndex = 0 to (array.size(_pivotHighTops) == 0 ? na : array.size(_pivotHighTops) - 1)
        _zoneTop = array.get(_pivotHighTops, _zoneIndex)
        _zoneBottom = array.get(_pivotHighBottoms, _zoneIndex)
        _zoneBullish = array.get(_pivotHighBullish, _zoneIndex)
        if close > _zoneTop and not _zoneBullish
            array.set(_pivotHighBullish, _zoneIndex, true)
        else if close < _zoneBottom and _zoneBullish
            array.set(_pivotHighBullish, _zoneIndex, false)
        _touched = time >= array.get(_pivotHighConfirmed, _zoneIndex) and high >= _zoneBottom and low <= _zoneTop
        if _touched
            array.set(_pivotHighFresh, _zoneIndex, false)

    for _zoneIndex = 0 to (array.size(_pivotLowTops) == 0 ? na : array.size(_pivotLowTops) - 1)
        _zoneTop = array.get(_pivotLowTops, _zoneIndex)
        _zoneBottom = array.get(_pivotLowBottoms, _zoneIndex)
        _zoneBullish = array.get(_pivotLowBullish, _zoneIndex)
        if close > _zoneTop and not _zoneBullish
            array.set(_pivotLowBullish, _zoneIndex, true)
        else if close < _zoneBottom and _zoneBullish
            array.set(_pivotLowBullish, _zoneIndex, false)
        _touched = time >= array.get(_pivotLowConfirmed, _zoneIndex) and high >= _zoneBottom and low <= _zoneTop
        if _touched
            array.set(_pivotLowFresh, _zoneIndex, false)

    _pivotSupportTops = array.new_float(0)
    _pivotSupportBottoms = array.new_float(0)
    _pivotSupportOrigin = array.new_int(0)
    _pivotSupportConfirmed = array.new_int(0)
    _pivotSupportFresh = array.new_bool(0)
    _pivotResistanceTops = array.new_float(0)
    _pivotResistanceBottoms = array.new_float(0)
    _pivotResistanceOrigin = array.new_int(0)
    _pivotResistanceConfirmed = array.new_int(0)
    _pivotResistanceFresh = array.new_bool(0)

    for _zoneIndex = 0 to (array.size(_pivotHighTops) == 0 ? na : array.size(_pivotHighTops) - 1)
        _zoneTop = array.get(_pivotHighTops, _zoneIndex)
        _zoneBottom = array.get(_pivotHighBottoms, _zoneIndex)
        if array.get(_pivotHighBullish, _zoneIndex)
            array.push(_pivotSupportTops, _zoneTop)
            array.push(_pivotSupportBottoms, _zoneBottom)
            array.push(_pivotSupportOrigin, array.get(_pivotHighOrigin, _zoneIndex))
            array.push(_pivotSupportConfirmed, array.get(_pivotHighConfirmed, _zoneIndex))
            array.push(_pivotSupportFresh, array.get(_pivotHighFresh, _zoneIndex))
        else
            array.push(_pivotResistanceTops, _zoneTop)
            array.push(_pivotResistanceBottoms, _zoneBottom)
            array.push(_pivotResistanceOrigin, array.get(_pivotHighOrigin, _zoneIndex))
            array.push(_pivotResistanceConfirmed, array.get(_pivotHighConfirmed, _zoneIndex))
            array.push(_pivotResistanceFresh, array.get(_pivotHighFresh, _zoneIndex))

    for _zoneIndex = 0 to (array.size(_pivotLowTops) == 0 ? na : array.size(_pivotLowTops) - 1)
        _zoneTop = array.get(_pivotLowTops, _zoneIndex)
        _zoneBottom = array.get(_pivotLowBottoms, _zoneIndex)
        if array.get(_pivotLowBullish, _zoneIndex)
            array.push(_pivotSupportTops, _zoneTop)
            array.push(_pivotSupportBottoms, _zoneBottom)
            array.push(_pivotSupportOrigin, array.get(_pivotLowOrigin, _zoneIndex))
            array.push(_pivotSupportConfirmed, array.get(_pivotLowConfirmed, _zoneIndex))
            array.push(_pivotSupportFresh, array.get(_pivotLowFresh, _zoneIndex))
        else
            array.push(_pivotResistanceTops, _zoneTop)
            array.push(_pivotResistanceBottoms, _zoneBottom)
            array.push(_pivotResistanceOrigin, array.get(_pivotLowOrigin, _zoneIndex))
            array.push(_pivotResistanceConfirmed, array.get(_pivotLowConfirmed, _zoneIndex))
            array.push(_pivotResistanceFresh, array.get(_pivotLowFresh, _zoneIndex))

    [_pivotSupport1Top, _pivotSupport1Bottom, _pivotSupport1Origin, _pivotSupport1Confirmed, _pivotSupport1Fresh,
      _pivotSupport2Top, _pivotSupport2Bottom, _pivotSupport2Origin, _pivotSupport2Confirmed, _pivotSupport2Fresh,
      _pivotSupport3Top, _pivotSupport3Bottom, _pivotSupport3Origin, _pivotSupport3Confirmed, _pivotSupport3Fresh] =
      phase5_three_candidates(_pivotSupportTops, _pivotSupportBottoms, _pivotSupportOrigin, _pivotSupportConfirmed, _pivotSupportFresh, 1)
    [_pivotResistance1Top, _pivotResistance1Bottom, _pivotResistance1Origin, _pivotResistance1Confirmed, _pivotResistance1Fresh,
      _pivotResistance2Top, _pivotResistance2Bottom, _pivotResistance2Origin, _pivotResistance2Confirmed, _pivotResistance2Fresh,
      _pivotResistance3Top, _pivotResistance3Bottom, _pivotResistance3Origin, _pivotResistance3Confirmed, _pivotResistance3Fresh] =
      phase5_three_candidates(_pivotResistanceTops, _pivotResistanceBottoms, _pivotResistanceOrigin, _pivotResistanceConfirmed, _pivotResistanceFresh, -1)

    // EQH/EQL adapter — active nearby liquidity levels, kept separate from zones.
    _eqTop = ta.pivothigh(eq_len, eq_len)
    _eqBottom = ta.pivotlow(eq_len, eq_len)
    var float _previousEqTop = na
    var float _previousEqBottom = na
    var int _previousEqTopTime = na
    var int _previousEqBottomTime = na
    var float[] _eqhLevels = array.new_float()
    var int[] _eqhOrigin = array.new_int()
    var int[] _eqhConfirmed = array.new_int()
    var float[] _eqlLevels = array.new_float()
    var int[] _eqlOrigin = array.new_int()
    var int[] _eqlConfirmed = array.new_int()

    _i := array.size(_eqhLevels) - 1
    while _i >= 0
        if time >= array.get(_eqhConfirmed, _i) and high > array.get(_eqhLevels, _i)
            array.remove(_eqhLevels, _i)
            array.remove(_eqhOrigin, _i)
            array.remove(_eqhConfirmed, _i)
        _i -= 1

    _i := array.size(_eqlLevels) - 1
    while _i >= 0
        if time >= array.get(_eqlConfirmed, _i) and low < array.get(_eqlLevels, _i)
            array.remove(_eqlLevels, _i)
            array.remove(_eqlOrigin, _i)
            array.remove(_eqlConfirmed, _i)
        _i -= 1

    if not na(_eqTop)
        if not na(_previousEqTop) and math.max(_eqTop, _previousEqTop) < math.min(_eqTop, _previousEqTop) + _atr200 * eq_threshold
            if not array.includes(_eqhLevels, _eqTop)
                array.unshift(_eqhLevels, _eqTop)
                array.unshift(_eqhOrigin, _previousEqTopTime)
                array.unshift(_eqhConfirmed, time_close)
        _previousEqTop := _eqTop
        _previousEqTopTime := time[eq_len]
    if not na(_eqBottom)
        if not na(_previousEqBottom) and math.min(_eqBottom, _previousEqBottom) > math.max(_eqBottom, _previousEqBottom) - _atr200 * eq_threshold
            if not array.includes(_eqlLevels, _eqBottom)
                array.unshift(_eqlLevels, _eqBottom)
                array.unshift(_eqlOrigin, _previousEqBottomTime)
                array.unshift(_eqlConfirmed, time_close)
        _previousEqBottom := _eqBottom
        _previousEqBottomTime := time[eq_len]

    if array.size(_eqhLevels) > phase5ActiveCandidateCap
        array.pop(_eqhLevels)
        array.pop(_eqhOrigin)
        array.pop(_eqhConfirmed)
    if array.size(_eqlLevels) > phase5ActiveCandidateCap
        array.pop(_eqlLevels)
        array.pop(_eqlOrigin)
        array.pop(_eqlConfirmed)

    [_eqh1, _eqh1Origin, _eqh1Confirmed, _eqh2, _eqh2Origin, _eqh2Confirmed, _eqh3, _eqh3Origin, _eqh3Confirmed] =
      phase5_three_liquidity_levels(_eqhLevels, _eqhOrigin, _eqhConfirmed, true)
    [_eql1, _eql1Origin, _eql1Confirmed, _eql2, _eql2Origin, _eql2Confirmed, _eql3, _eql3Origin, _eql3Confirmed] =
      phase5_three_liquidity_levels(_eqlLevels, _eqlOrigin, _eqlConfirmed, false)

    _setupLocation = phase5_range_location(close, _lastSwingHigh, _lastSwingLow)
    Phase5SetupState.new(
      Phase5ZoneCandidate.new(_demand1Top[1], _demand1Bottom[1], _demand1Origin[1], _demand1Confirmed[1], _demand1Fresh[1]),
      Phase5ZoneCandidate.new(_demand2Top[1], _demand2Bottom[1], _demand2Origin[1], _demand2Confirmed[1], _demand2Fresh[1]),
      Phase5ZoneCandidate.new(_demand3Top[1], _demand3Bottom[1], _demand3Origin[1], _demand3Confirmed[1], _demand3Fresh[1]),
      Phase5ZoneCandidate.new(_supply1Top[1], _supply1Bottom[1], _supply1Origin[1], _supply1Confirmed[1], _supply1Fresh[1]),
      Phase5ZoneCandidate.new(_supply2Top[1], _supply2Bottom[1], _supply2Origin[1], _supply2Confirmed[1], _supply2Fresh[1]),
      Phase5ZoneCandidate.new(_supply3Top[1], _supply3Bottom[1], _supply3Origin[1], _supply3Confirmed[1], _supply3Fresh[1]),
      Phase5ZoneCandidate.new(_bullOb1Top[1], _bullOb1Bottom[1], _bullOb1Origin[1], _bullOb1Confirmed[1], _bullOb1Fresh[1]),
      Phase5ZoneCandidate.new(_bullOb2Top[1], _bullOb2Bottom[1], _bullOb2Origin[1], _bullOb2Confirmed[1], _bullOb2Fresh[1]),
      Phase5ZoneCandidate.new(_bullOb3Top[1], _bullOb3Bottom[1], _bullOb3Origin[1], _bullOb3Confirmed[1], _bullOb3Fresh[1]),
      Phase5ZoneCandidate.new(_bearOb1Top[1], _bearOb1Bottom[1], _bearOb1Origin[1], _bearOb1Confirmed[1], _bearOb1Fresh[1]),
      Phase5ZoneCandidate.new(_bearOb2Top[1], _bearOb2Bottom[1], _bearOb2Origin[1], _bearOb2Confirmed[1], _bearOb2Fresh[1]),
      Phase5ZoneCandidate.new(_bearOb3Top[1], _bearOb3Bottom[1], _bearOb3Origin[1], _bearOb3Confirmed[1], _bearOb3Fresh[1]),
      Phase5ZoneCandidate.new(_bullFvg1Top[1], _bullFvg1Bottom[1], _bullFvg1Origin[1], _bullFvg1Confirmed[1], _bullFvg1Fresh[1]),
      Phase5ZoneCandidate.new(_bullFvg2Top[1], _bullFvg2Bottom[1], _bullFvg2Origin[1], _bullFvg2Confirmed[1], _bullFvg2Fresh[1]),
      Phase5ZoneCandidate.new(_bullFvg3Top[1], _bullFvg3Bottom[1], _bullFvg3Origin[1], _bullFvg3Confirmed[1], _bullFvg3Fresh[1]),
      Phase5ZoneCandidate.new(_bearFvg1Top[1], _bearFvg1Bottom[1], _bearFvg1Origin[1], _bearFvg1Confirmed[1], _bearFvg1Fresh[1]),
      Phase5ZoneCandidate.new(_bearFvg2Top[1], _bearFvg2Bottom[1], _bearFvg2Origin[1], _bearFvg2Confirmed[1], _bearFvg2Fresh[1]),
      Phase5ZoneCandidate.new(_bearFvg3Top[1], _bearFvg3Bottom[1], _bearFvg3Origin[1], _bearFvg3Confirmed[1], _bearFvg3Fresh[1]),
      Phase5ZoneCandidate.new(_pivotSupport1Top[1], _pivotSupport1Bottom[1], _pivotSupport1Origin[1], _pivotSupport1Confirmed[1], _pivotSupport1Fresh[1]),
      Phase5ZoneCandidate.new(_pivotSupport2Top[1], _pivotSupport2Bottom[1], _pivotSupport2Origin[1], _pivotSupport2Confirmed[1], _pivotSupport2Fresh[1]),
      Phase5ZoneCandidate.new(_pivotSupport3Top[1], _pivotSupport3Bottom[1], _pivotSupport3Origin[1], _pivotSupport3Confirmed[1], _pivotSupport3Fresh[1]),
      Phase5ZoneCandidate.new(_pivotResistance1Top[1], _pivotResistance1Bottom[1], _pivotResistance1Origin[1], _pivotResistance1Confirmed[1], _pivotResistance1Fresh[1]),
      Phase5ZoneCandidate.new(_pivotResistance2Top[1], _pivotResistance2Bottom[1], _pivotResistance2Origin[1], _pivotResistance2Confirmed[1], _pivotResistance2Fresh[1]),
      Phase5ZoneCandidate.new(_pivotResistance3Top[1], _pivotResistance3Bottom[1], _pivotResistance3Origin[1], _pivotResistance3Confirmed[1], _pivotResistance3Fresh[1]),
      Phase5LiquidityCandidate.new(_eqh1[1], _eqh1Origin[1], _eqh1Confirmed[1]),
      Phase5LiquidityCandidate.new(_eqh2[1], _eqh2Origin[1], _eqh2Confirmed[1]),
      Phase5LiquidityCandidate.new(_eqh3[1], _eqh3Origin[1], _eqh3Confirmed[1]),
      Phase5LiquidityCandidate.new(_eql1[1], _eql1Origin[1], _eql1Confirmed[1]),
      Phase5LiquidityCandidate.new(_eql2[1], _eql2Origin[1], _eql2Confirmed[1]),
      Phase5LiquidityCandidate.new(_eql3[1], _eql3Origin[1], _eql3Confirmed[1]),
      _setupLocation[1], _lastSwingHigh[1], _lastSwingLow[1])

// Safe confirmed OHLC feeds are exposed for inspection and future Phase-6 use.
[phase5MacroOpen, phase5MacroHighBar, phase5MacroLowBar, phase5MacroClose, phase5MacroTime] = phase5_confirmed_ohlc(phase5MacroTf)
[phase5BiasOpen, phase5BiasHighBar, phase5BiasLowBar, phase5BiasClose, phase5BiasTime] = phase5_confirmed_ohlc(phase5BiasTf)
[phase5SetupOpen, phase5SetupHighBar, phase5SetupLowBar, phase5SetupClose, phase5SetupTime] = phase5_confirmed_ohlc(phase5SetupTf)

// Safe data-only liquidity references from fully completed calendar periods.
// The original optional D/W/M drawings remain untouched and independent.
[phase5PrevDayHighRaw, phase5PrevDayLowRaw] = phase5_confirmed_previous_hl('D')
[phase5PrevWeekHighRaw, phase5PrevWeekLowRaw] = phase5_confirmed_previous_hl('W')
[phase5PrevMonthHighRaw, phase5PrevMonthLowRaw] = phase5_confirmed_previous_hl('M')

// -----------------------------------------------------------------------------
// PHASE 5 / PIECE 3 OF 8 — 4H Macro Context Module
// -----------------------------------------------------------------------------
[phase5MacroBiasRaw, phase5MacroSwingHigh, phase5MacroSwingLow, phase5MacroBreakDirection, phase5MacroLocation] =
  request.security(syminfo.tickerid, phase5MacroTf, phase5_structure_packet(length), lookahead=barmerge.lookahead_on)

phase5MacroRange = not na(phase5MacroSwingHigh) and not na(phase5MacroSwingLow) ? phase5MacroSwingHigh - phase5MacroSwingLow : na

// -----------------------------------------------------------------------------
// PHASE 5 / PIECE 4 OF 8 — 1H Primary Bias Module
// -----------------------------------------------------------------------------
[phase5Bias1HRaw, phase5Bias1HSwingHigh, phase5Bias1HSwingLow, phase5Bias1HBreakDirection, phase5Bias1HLocation] =
  request.security(syminfo.tickerid, phase5BiasTf, phase5_structure_packet(length), lookahead=barmerge.lookahead_on)

// -----------------------------------------------------------------------------
// PHASE 5 / PIECE 5 OF 8 — 15m Setup / AOI Module
// Separate outputs remain separate; this module does not calculate an AOI score.
// -----------------------------------------------------------------------------
phase5SetupStateRaw = request.security(syminfo.tickerid, phase5SetupTf, phase5_setup_packet(), lookahead=barmerge.lookahead_on, calc_bars_count=phase5SetupHistoryBars)
phase5SetupStateRaw := na(phase5SetupStateRaw) ? phase5_empty_setup_state() : phase5SetupStateRaw

// -----------------------------------------------------------------------------
// PHASE 5 / PIECE 6 OF 8 — 5m Execution Context Module
// Reuses current-chart engines and publishes both live and confirmed states.
// -----------------------------------------------------------------------------
phase5ExecInternalTrendLive = itrend
phase5ExecSwingTrendLive = trend
phase5ExecTrendLive = phase5ExecInternalTrendLive
phase5ExecInternalBullChochLive = bull_ichoch_alert
phase5ExecInternalBearChochLive = bear_ichoch_alert
phase5ExecSwingBullChochLive = bull_choch_alert
phase5ExecSwingBearChochLive = bear_choch_alert
phase5ExecBullChochLive = phase5ExecInternalBullChochLive or phase5ExecSwingBullChochLive
phase5ExecBearChochLive = phase5ExecInternalBearChochLive or phase5ExecSwingBearChochLive
phase5ExecBullReactionLive = bullCheck
phase5ExecBearReactionLive = bearCheck

phase5MacdLive = macdLabel == color.lime ? 1 : macdLabel == color.red ? -1 : 0
phase5StochLive = stochLabel == color.lime ? 1 : stochLabel == color.red ? -1 : 0
phase5VortexLive = vortexLabel == color.lime ? 1 : vortexLabel == color.red ? -1 : 0
phase5MomentumIndicatorLive = momLabel == color.lime ? 1 : momLabel == color.red ? -1 : 0
phase5RsiLive = rsiLabel == color.lime ? 1 : rsiLabel == color.red ? -1 : 0
phase5PsarLive = psarLabel == color.lime ? 1 : psarLabel == color.red ? -1 : 0
phase5DmiLive = dmiLabel == color.lime ? 1 : dmiLabel == color.red ? -1 : 0
phase5MfiLive = mfiLabel == color.lime ? 1 : mfiLabel == color.red ? -1 : 0
phase5FisherLive = fisherLabel == color.lime ? 1 : fisherLabel == color.red ? -1 : 0

phase5BullCountLive = (phase5MacdLive == 1 ? 1 : 0) + (phase5StochLive == 1 ? 1 : 0) +
  (phase5VortexLive == 1 ? 1 : 0) + (phase5MomentumIndicatorLive == 1 ? 1 : 0) +
  (phase5RsiLive == 1 ? 1 : 0) + (phase5PsarLive == 1 ? 1 : 0) +
  (phase5DmiLive == 1 ? 1 : 0) + (phase5MfiLive == 1 ? 1 : 0) + (phase5FisherLive == 1 ? 1 : 0)
phase5BearCountLive = (phase5MacdLive == -1 ? 1 : 0) + (phase5StochLive == -1 ? 1 : 0) +
  (phase5VortexLive == -1 ? 1 : 0) + (phase5MomentumIndicatorLive == -1 ? 1 : 0) +
  (phase5RsiLive == -1 ? 1 : 0) + (phase5PsarLive == -1 ? 1 : 0) +
  (phase5DmiLive == -1 ? 1 : 0) + (phase5MfiLive == -1 ? 1 : 0) + (phase5FisherLive == -1 ? 1 : 0)
phase5ExecMomentumLive = phase5BullCountLive == 9 ? 1 : phase5BearCountLive == 9 ? -1 : 0
phase5ExecBulbLive = isOversold ? 1 : isOverbought ? -1 : 0
phase5ExecAtrLive = atrv

phase5ExecInternalTrendConfirmed = barstate.isconfirmed ? phase5ExecInternalTrendLive : phase5ExecInternalTrendLive[1]
phase5ExecSwingTrendConfirmed = barstate.isconfirmed ? phase5ExecSwingTrendLive : phase5ExecSwingTrendLive[1]
phase5ExecTrendConfirmed = phase5ExecInternalTrendConfirmed
phase5ExecInternalBullChochConfirmed = barstate.isconfirmed ? phase5ExecInternalBullChochLive : phase5ExecInternalBullChochLive[1]
phase5ExecInternalBearChochConfirmed = barstate.isconfirmed ? phase5ExecInternalBearChochLive : phase5ExecInternalBearChochLive[1]
phase5ExecSwingBullChochConfirmed = barstate.isconfirmed ? phase5ExecSwingBullChochLive : phase5ExecSwingBullChochLive[1]
phase5ExecSwingBearChochConfirmed = barstate.isconfirmed ? phase5ExecSwingBearChochLive : phase5ExecSwingBearChochLive[1]
phase5ExecBullChochConfirmed = barstate.isconfirmed ? phase5ExecBullChochLive : phase5ExecBullChochLive[1]
phase5ExecBearChochConfirmed = barstate.isconfirmed ? phase5ExecBearChochLive : phase5ExecBearChochLive[1]
phase5ExecBullReactionConfirmed = barstate.isconfirmed ? phase5ExecBullReactionLive : phase5ExecBullReactionLive[1]
phase5ExecBearReactionConfirmed = barstate.isconfirmed ? phase5ExecBearReactionLive : phase5ExecBearReactionLive[1]
phase5MacdConfirmed = barstate.isconfirmed ? phase5MacdLive : phase5MacdLive[1]
phase5StochConfirmed = barstate.isconfirmed ? phase5StochLive : phase5StochLive[1]
phase5VortexConfirmed = barstate.isconfirmed ? phase5VortexLive : phase5VortexLive[1]
phase5MomentumIndicatorConfirmed = barstate.isconfirmed ? phase5MomentumIndicatorLive : phase5MomentumIndicatorLive[1]
phase5RsiConfirmed = barstate.isconfirmed ? phase5RsiLive : phase5RsiLive[1]
phase5PsarConfirmed = barstate.isconfirmed ? phase5PsarLive : phase5PsarLive[1]
phase5DmiConfirmed = barstate.isconfirmed ? phase5DmiLive : phase5DmiLive[1]
phase5MfiConfirmed = barstate.isconfirmed ? phase5MfiLive : phase5MfiLive[1]
phase5FisherConfirmed = barstate.isconfirmed ? phase5FisherLive : phase5FisherLive[1]
phase5BullCountConfirmed = barstate.isconfirmed ? phase5BullCountLive : phase5BullCountLive[1]
phase5BearCountConfirmed = barstate.isconfirmed ? phase5BearCountLive : phase5BearCountLive[1]
phase5ExecMomentumConfirmed = barstate.isconfirmed ? phase5ExecMomentumLive : phase5ExecMomentumLive[1]
phase5ExecBulbConfirmed = barstate.isconfirmed ? phase5ExecBulbLive : phase5ExecBulbLive[1]
phase5ExecAtrConfirmed = barstate.isconfirmed ? phase5ExecAtrLive : phase5ExecAtrLive[1]

// -----------------------------------------------------------------------------
// PHASE 5 / PIECE 7 OF 8 — Session State Module
// Context only; no session is used as a hard gate.
// -----------------------------------------------------------------------------
phase5AsiaHours = input.session('0900-1800', 'Asia hours', group='Phase 5 — Sessions')
phase5LondonHours = input.session('0800-1700', 'London hours', group='Phase 5 — Sessions')
phase5NewYorkHours = input.session('0800-1700', 'New York hours', group='Phase 5 — Sessions')
phase5InAsia = not na(time(timeframe.period, phase5AsiaHours, 'Asia/Tokyo'))
phase5InLondon = not na(time(timeframe.period, phase5LondonHours, 'Europe/London'))
phase5InNewYork = not na(time(timeframe.period, phase5NewYorkHours, 'America/New_York'))
phase5SessionStateRaw = phase5InLondon and phase5InNewYork ? 'LONDON_NY_OVERLAP' :
  phase5InLondon ? 'LONDON' : phase5InNewYork ? 'NEW_YORK' : phase5InAsia ? 'ASIA' : 'OFF_SESSION'

// -----------------------------------------------------------------------------
// PHASE 5 / PIECE 8 OF 8 — MTF State Interface + Debug Table
// These aliases are the stable contract that Phase 6 can consume later.
// -----------------------------------------------------------------------------
macro4HBias = phase5MacroBiasRaw
macro4HHigh = phase5MacroSwingHigh
macro4HLow = phase5MacroSwingLow
macro4HBreak = phase5MacroBreakDirection
macro4HRange = phase5MacroRange

bias1H = phase5Bias1HRaw
bias1HBreak = phase5Bias1HBreakDirection
bias1HLocation = phase5Bias1HLocation

prevDayHigh = phase5PrevDayHighRaw
prevDayLow = phase5PrevDayLowRaw
prevWeekHigh = phase5PrevWeekHighRaw
prevWeekLow = phase5PrevWeekLowRaw
prevMonthHigh = phase5PrevMonthHighRaw
prevMonthLow = phase5PrevMonthLowRaw

// Each AOI family publishes its nearest three active candidates. Origin is the
// source candle/pivot time, Confirmed is when the zone became knowable, and
// Fresh records whether price has revisited the active zone after confirmation.
setup15mDemand1Top = phase5SetupStateRaw.demand1.top
setup15mDemand1Bottom = phase5SetupStateRaw.demand1.bottom
setup15mDemand1Origin = phase5SetupStateRaw.demand1.origin
setup15mDemand1Confirmed = phase5SetupStateRaw.demand1.confirmed
setup15mDemand1Fresh = phase5SetupStateRaw.demand1.fresh
setup15mDemand1Born = setup15mDemand1Origin
setup15mDemand2Top = phase5SetupStateRaw.demand2.top
setup15mDemand2Bottom = phase5SetupStateRaw.demand2.bottom
setup15mDemand2Origin = phase5SetupStateRaw.demand2.origin
setup15mDemand2Confirmed = phase5SetupStateRaw.demand2.confirmed
setup15mDemand2Fresh = phase5SetupStateRaw.demand2.fresh
setup15mDemand2Born = setup15mDemand2Origin
setup15mDemand3Top = phase5SetupStateRaw.demand3.top
setup15mDemand3Bottom = phase5SetupStateRaw.demand3.bottom
setup15mDemand3Origin = phase5SetupStateRaw.demand3.origin
setup15mDemand3Confirmed = phase5SetupStateRaw.demand3.confirmed
setup15mDemand3Fresh = phase5SetupStateRaw.demand3.fresh
setup15mDemand3Born = setup15mDemand3Origin

setup15mSupply1Top = phase5SetupStateRaw.supply1.top
setup15mSupply1Bottom = phase5SetupStateRaw.supply1.bottom
setup15mSupply1Origin = phase5SetupStateRaw.supply1.origin
setup15mSupply1Confirmed = phase5SetupStateRaw.supply1.confirmed
setup15mSupply1Fresh = phase5SetupStateRaw.supply1.fresh
setup15mSupply1Born = setup15mSupply1Origin
setup15mSupply2Top = phase5SetupStateRaw.supply2.top
setup15mSupply2Bottom = phase5SetupStateRaw.supply2.bottom
setup15mSupply2Origin = phase5SetupStateRaw.supply2.origin
setup15mSupply2Confirmed = phase5SetupStateRaw.supply2.confirmed
setup15mSupply2Fresh = phase5SetupStateRaw.supply2.fresh
setup15mSupply2Born = setup15mSupply2Origin
setup15mSupply3Top = phase5SetupStateRaw.supply3.top
setup15mSupply3Bottom = phase5SetupStateRaw.supply3.bottom
setup15mSupply3Origin = phase5SetupStateRaw.supply3.origin
setup15mSupply3Confirmed = phase5SetupStateRaw.supply3.confirmed
setup15mSupply3Fresh = phase5SetupStateRaw.supply3.fresh
setup15mSupply3Born = setup15mSupply3Origin

setup15mBullOB1Top = phase5SetupStateRaw.bullOb1.top
setup15mBullOB1Bottom = phase5SetupStateRaw.bullOb1.bottom
setup15mBullOB1Origin = phase5SetupStateRaw.bullOb1.origin
setup15mBullOB1Confirmed = phase5SetupStateRaw.bullOb1.confirmed
setup15mBullOB1Fresh = phase5SetupStateRaw.bullOb1.fresh
setup15mBullOB1Born = setup15mBullOB1Origin
setup15mBullOB2Top = phase5SetupStateRaw.bullOb2.top
setup15mBullOB2Bottom = phase5SetupStateRaw.bullOb2.bottom
setup15mBullOB2Origin = phase5SetupStateRaw.bullOb2.origin
setup15mBullOB2Confirmed = phase5SetupStateRaw.bullOb2.confirmed
setup15mBullOB2Fresh = phase5SetupStateRaw.bullOb2.fresh
setup15mBullOB2Born = setup15mBullOB2Origin
setup15mBullOB3Top = phase5SetupStateRaw.bullOb3.top
setup15mBullOB3Bottom = phase5SetupStateRaw.bullOb3.bottom
