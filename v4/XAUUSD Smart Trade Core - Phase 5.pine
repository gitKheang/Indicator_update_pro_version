exec5mBearCHoCHLive = phase5ExecBearChochLive
exec5mBullReactionLive = phase5ExecBullReactionLive
exec5mBearReactionLive = phase5ExecBearReactionLive
exec5mMomentumLive = phase5ExecMomentumLive
exec5mBULBLive = phase5ExecBulbLive
exec5mATRLive = phase5ExecAtrLive

exec5mBullCount = phase5BullCountConfirmed
exec5mBearCount = phase5BearCountConfirmed
exec5mMACD = phase5MacdConfirmed
exec5mStoch = phase5StochConfirmed
exec5mVortex = phase5VortexConfirmed
exec5mMomentumIndicator = phase5MomentumIndicatorConfirmed
exec5mRSI = phase5RsiConfirmed
exec5mPSAR = phase5PsarConfirmed
exec5mDMI = phase5DmiConfirmed
exec5mMFI = phase5MfiConfirmed
exec5mFisher = phase5FisherConfirmed
sessionState = phase5SessionStateRaw

phase5_bias_text(_state) =>
    _state == 1 ? 'Bullish' : _state == -1 ? 'Bearish' : 'Neutral'

phase5_direction_text(_state) =>
    _state == 1 ? 'Bullish break' : _state == -1 ? 'Bearish break' : 'No new break'

phase5_location_text(_state) =>
    _state == 1 ? 'Premium' : _state == -1 ? 'Discount' : _state == 0 ? 'Equilibrium' :
      _state == 2 ? 'Above equilibrium' : _state == -2 ? 'Below equilibrium' : 'Unavailable'

phase5_price_text(_price) =>
    na(_price) ? '—' : str.tostring(_price, format.mintick)

phase5_zone_text(_top, _bottom) =>
    na(_top) or na(_bottom) ? '—' : phase5_price_text(_bottom) + '–' + phase5_price_text(_top)

phase5_candidate_count(_top1, _top2, _top3) =>
    (not na(_top1) ? 1 : 0) + (not na(_top2) ? 1 : 0) + (not na(_top3) ? 1 : 0)

phase5_compact_state(_state) =>
    _state == 1 ? '+' : _state == -1 ? '-' : '0'

phase5_state_color(_state) =>
    _state == 1 ? color.new(color.lime, 70) : _state == -1 ? color.new(color.red, 70) : color.new(color.gray, 75)

phase5DebugOn = input.bool(true, 'Show MTF Debug Table', group='Phase 5 — Debug')
phase5DebugPosition = input.string(position.top_right, 'Table position', options=[position.top_right, position.top_left, position.bottom_right, position.bottom_left], group='Phase 5 — Debug')
var table phase5DebugTable = table.new(phase5DebugPosition, 2, 28, border_width=1)

phase5_debug_row(_row, _name, _value, _background) =>
    table.cell(phase5DebugTable, 0, _row, _name, text_color=color.white, bgcolor=color.new(color.black, 15), text_size=size.tiny)
    table.cell(phase5DebugTable, 1, _row, _value, text_color=color.white, bgcolor=_background, text_size=size.tiny)

if barstate.islast
    if phase5DebugOn
        table.cell(phase5DebugTable, 0, 0, 'PHASE 5 MTF STATE', text_color=color.white, bgcolor=color.new(color.purple, 20), text_size=size.tiny)
        table.cell(phase5DebugTable, 1, 0, phase5ExecutionTfOk and phase5TfHierarchyOk ? '5m chart OK' : 'Use locked 5m chart', text_color=color.white, bgcolor=phase5ExecutionTfOk and phase5TfHierarchyOk ? color.new(color.green, 55) : color.new(color.orange, 35), text_size=size.tiny)
        phase5_debug_row(1, '4H macro bias', phase5_bias_text(macro4HBias), phase5_state_color(macro4HBias))
        phase5_debug_row(2, '4H high / low', phase5_price_text(macro4HHigh) + ' / ' + phase5_price_text(macro4HLow), color.new(color.gray, 75))
        phase5_debug_row(3, '4H latest break', phase5_direction_text(macro4HBreak), phase5_state_color(macro4HBreak))
        phase5_debug_row(4, '1H primary bias', phase5_bias_text(bias1H), phase5_state_color(bias1H))
        phase5_debug_row(5, '1H confirmed swing location', phase5_location_text(bias1HLocation), color.new(color.gray, 75))
        phase5_debug_row(6, 'Previous D high / low', phase5_price_text(prevDayHigh) + ' / ' + phase5_price_text(prevDayLow), color.new(color.gray, 75))
        phase5_debug_row(7, 'Previous W high / low', phase5_price_text(prevWeekHigh) + ' / ' + phase5_price_text(prevWeekLow), color.new(color.gray, 75))
        phase5_debug_row(8, 'Previous M high / low', phase5_price_text(prevMonthHigh) + ' / ' + phase5_price_text(prevMonthLow), color.new(color.gray, 75))
        phase5_debug_row(9, '15m demand / supply', phase5_zone_text(setup15mDemandTop, setup15mDemandBottom) + ' / ' + phase5_zone_text(setup15mSupplyTop, setup15mSupplyBottom), color.new(color.gray, 75))
        phase5_debug_row(10, '15m bull / bear OB', phase5_zone_text(setup15mBullOBTop, setup15mBullOBBottom) + ' / ' + phase5_zone_text(setup15mBearOBTop, setup15mBearOBBottom), color.new(color.gray, 75))
        phase5_debug_row(11, '15m bull / bear FVG', phase5_zone_text(setup15mBullFVGTop, setup15mBullFVGBottom) + ' / ' + phase5_zone_text(setup15mBearFVGTop, setup15mBearFVGBottom), color.new(color.gray, 75))
        phase5_debug_row(12, '15m pivot S / R', phase5_zone_text(setup15mPivotSupportTop, setup15mPivotSupportBottom) + ' / ' + phase5_zone_text(setup15mPivotResistanceTop, setup15mPivotResistanceBottom), color.new(color.gray, 75))
        phase5_debug_row(13, '15m pool D/S BO/SO BF/SF PS/PR', str.tostring(phase5_candidate_count(setup15mDemand1Top, setup15mDemand2Top, setup15mDemand3Top)) + '/' + str.tostring(phase5_candidate_count(setup15mSupply1Top, setup15mSupply2Top, setup15mSupply3Top)) + ' ' + str.tostring(phase5_candidate_count(setup15mBullOB1Top, setup15mBullOB2Top, setup15mBullOB3Top)) + '/' + str.tostring(phase5_candidate_count(setup15mBearOB1Top, setup15mBearOB2Top, setup15mBearOB3Top)) + ' ' + str.tostring(phase5_candidate_count(setup15mBullFVG1Top, setup15mBullFVG2Top, setup15mBullFVG3Top)) + '/' + str.tostring(phase5_candidate_count(setup15mBearFVG1Top, setup15mBearFVG2Top, setup15mBearFVG3Top)) + ' ' + str.tostring(phase5_candidate_count(setup15mPivotSupport1Top, setup15mPivotSupport2Top, setup15mPivotSupport3Top)) + '/' + str.tostring(phase5_candidate_count(setup15mPivotResistance1Top, setup15mPivotResistance2Top, setup15mPivotResistance3Top)), color.new(color.gray, 75))
        phase5_debug_row(14, '15m EQH / EQL', phase5_price_text(setup15mEQH) + ' / ' + phase5_price_text(setup15mEQL), color.new(color.gray, 75))
        phase5_debug_row(15, '15m EQH / EQL pools', str.tostring(phase5_candidate_count(setup15mEQH1, setup15mEQH2, setup15mEQH3)) + ' / ' + str.tostring(phase5_candidate_count(setup15mEQL1, setup15mEQL2, setup15mEQL3)), color.new(color.gray, 75))
        phase5_debug_row(16, '15m confirmed swing high / low', phase5_price_text(setup15mSwingHigh) + ' / ' + phase5_price_text(setup15mSwingLow), color.new(color.gray, 75))
        phase5_debug_row(17, '15m confirmed swing location', phase5_location_text(setup15mLocation), color.new(color.gray, 75))
        phase5_debug_row(18, '5m internal / swing trend', phase5_bias_text(exec5mInternalTrend) + ' / ' + phase5_bias_text(exec5mSwingTrend), color.new(color.gray, 75))
        phase5_debug_row(19, '5m internal CHoCH B/S', str.tostring(exec5mInternalBullCHoCH) + ' / ' + str.tostring(exec5mInternalBearCHoCH), color.new(color.gray, 75))
        phase5_debug_row(20, '5m swing CHoCH B/S', str.tostring(exec5mSwingBullCHoCH) + ' / ' + str.tostring(exec5mSwingBearCHoCH), color.new(color.gray, 75))
        phase5_debug_row(21, '5m confirmed reaction B/S', str.tostring(exec5mBullReaction) + ' / ' + str.tostring(exec5mBearReaction), color.new(color.gray, 75))
        phase5_debug_row(22, '5m dashboard bull / bear', str.tostring(exec5mBullCount) + ' / ' + str.tostring(exec5mBearCount), color.new(color.gray, 75))
        phase5_debug_row(23, 'M S V Mom R P D MF F', phase5_compact_state(exec5mMACD) + ' ' + phase5_compact_state(exec5mStoch) + ' ' + phase5_compact_state(exec5mVortex) + ' ' + phase5_compact_state(exec5mMomentumIndicator) + ' ' + phase5_compact_state(exec5mRSI) + ' ' + phase5_compact_state(exec5mPSAR) + ' ' + phase5_compact_state(exec5mDMI) + ' ' + phase5_compact_state(exec5mMFI) + ' ' + phase5_compact_state(exec5mFisher), color.new(color.gray, 75))
        phase5_debug_row(24, '5m 9/9 consensus', phase5_bias_text(exec5mMomentum), phase5_state_color(exec5mMomentum))
        phase5_debug_row(25, '5m BULB context', exec5mBULB == 1 ? 'Oversold' : exec5mBULB == -1 ? 'Overbought' : 'Neutral', phase5_state_color(exec5mBULB))
        phase5_debug_row(26, '5m ATR(89)', phase5_price_text(exec5mATR), color.new(color.gray, 75))
        phase5_debug_row(27, 'Session', sessionState, color.new(color.blue, 65))
    else
        table.clear(phase5DebugTable, 0, 0, 1, 27)
