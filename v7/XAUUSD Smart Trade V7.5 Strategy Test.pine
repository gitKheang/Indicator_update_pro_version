// =============================================================================
// ENGINE 6 — TREND-ALIGNED STRUCTURE TRIGGER
// A setup exists on the confirmed 5m bar that breaks an internal swing (internal
// CHoCH or continuation BOS) in the direction of BOTH the 4H and the 1H bias,
// while the 5m Supertrend(10, 3) agrees: the end of a pullback inside an
// established trend, with the short-term trend already turned back.
// V7.4 added the Supertrend check (TradingView built-in ta.supertrend,
// non-repainting): win rate 49.4% -> 52.4%, PF 1.45 -> 1.65.
// V7.5 added two regime/quality checks, both measured on 2024-01..2026-10:
//   * Fast pullback: the break comes at most 11 bars after the broken internal
//     pivot. A trend that resumes quickly continues; slow, drawn-out pullbacks
//     (12+ bars) won only 42.5%. Thresholds 9-14 all improve the result.
//   * Calm 1H: Choppiness Index(14) of the last completed 1H bar below 50
//     (E.W. Dreiss). Setups in a choppy 1H regime (>= 49) won 43.7%.
//   Together: 52.4% -> 60.4% win rate, PF 1.65 -> 2.29, max DD 8.5R -> 4.3R,
//   0.56 -> 0.33 trades per day; in-sample 60.1%, out-of-sample 60.9%.
// V7.2 removed the former AOI score/lock/touch/confirm pipeline. Measured on
// XAUUSD 5m 2024-01..2026-10: first touches of every Phase-5 zone family held
// only 34–44% of the time at 1.5R (a level with no edge ≈ 40%), on 15m, 1H and
// 4H zones alike, and requiring an AOI touch made the trend trigger worse.
// The Phase-5 zones are still used below, as obstacles and TP2 caps.
// -----------------------------------------------------------------------------
phase6CanAdvance = barstate.isconfirmed and phase5ExecutionTfOk and phase5TfHierarchyOk

// Bar index of the internal (5-bar) swing pivots, so the stop can sit beyond the
// protected extreme of the leg that was just broken.
var int phase6InternalTopBar = na
var int phase6InternalBottomBar = na
if itop != 0
    phase6InternalTopBar := bar_index - 5
if ibtm != 0
    phase6InternalBottomBar := bar_index - 5

phase6UseSupertrend = input.bool(true, 'Require 5m Supertrend agreement', group='Engine 6 — Trigger', tooltip='Short-term trend confirmation: trade only when the 5m Supertrend points the same way as the trade.')
phase6StFactor = input.float(3.0, 'Supertrend factor', minval=0.5, step=0.5, group='Engine 6 — Trigger')
phase6StPeriod = input.int(10, 'Supertrend ATR period', minval=1, group='Engine 6 — Trigger')
[phase6StLine, phase6StDirection] = ta.supertrend(phase6StFactor, phase6StPeriod)
// ta.supertrend direction is negative while the trend is up.
phase6StTrend = phase6StDirection < 0 ? 1 : -1

phase6UseFastPullback = input.bool(true, 'Require fast pullback', group='Engine 6 — Trigger', tooltip='Trade only when the break comes within the set number of 5m bars after the broken internal swing pivot: a quick pullback that resumes the trend. Backtest 2024-01..2026-10: breaks 12+ bars after the pivot won 42.5%.')
phase6MaxPullbackBars = input.int(11, 'Max bars from broken pivot to break', minval=6, maxval=200, group='Engine 6 — Trigger')
phase6UseCalm1H = input.bool(true, 'Require calm 1H (Choppiness Index)', group='Engine 6 — Trigger', tooltip='Choppiness Index (E.W. Dreiss) of the last completed 1H bar must be below the maximum. High values mean a sideways, two-way market where trend breaks fail more often (43.7% win rate when >= 49). OFF: more trades (about 0.44/day), 57.7% win rate.')
phase6ChopLength = input.int(14, '1H Choppiness length', minval=2, group='Engine 6 — Trigger')
phase6ChopMax = input.float(50.0, '1H Choppiness maximum', minval=0.0, maxval=100.0, step=1.0, group='Engine 6 — Trigger')

// Last completed 1H bar only ([1] with lookahead on): no repainting.
phase6_chop_packet(_length) =>
    _range = ta.highest(high, _length) - ta.lowest(low, _length)
    _chop = _range > 0 ? 100 * math.log10(math.sum(ta.tr(true), _length) / _range) / math.log10(_length) : na
    _chop[1]
phase6Chop1H = request.security(syminfo.tickerid, phase5BiasTf, phase6_chop_packet(phase6ChopLength), lookahead=barmerge.lookahead_on)
phase6RegimeOk = not phase6UseCalm1H or (not na(phase6Chop1H) and phase6Chop1H < phase6ChopMax)
phase6LongPivotAge = na(phase6InternalTopBar) ? na : bar_index - phase6InternalTopBar
phase6ShortPivotAge = na(phase6InternalBottomBar) ? na : bar_index - phase6InternalBottomBar
phase6LongFast = not phase6UseFastPullback or (not na(phase6LongPivotAge) and phase6LongPivotAge <= phase6MaxPullbackBars)
phase6ShortFast = not phase6UseFastPullback or (not na(phase6ShortPivotAge) and phase6ShortPivotAge <= phase6MaxPullbackBars)

phase6LongTrigger = phase6CanAdvance and exec5mInternalBullBreak and macro4HBias == 1 and bias1H == 1 and (not phase6UseSupertrend or phase6StTrend == 1) and phase6LongFast and phase6RegimeOk
phase6ShortTrigger = phase6CanAdvance and exec5mInternalBearBreak and macro4HBias == -1 and bias1H == -1 and (not phase6UseSupertrend or phase6StTrend == -1) and phase6ShortFast and phase6RegimeOk
phase6Side = phase6LongTrigger ? 1 : phase6ShortTrigger ? -1 : 0
phase6DirectionContext = macro4HBias == 1 and bias1H == 1 ? 1 : macro4HBias == -1 and bias1H == -1 ? -1 : 0
phase6DirectionText = phase6DirectionContext == 1 ? 'BULLISH (longs only)' : phase6DirectionContext == -1 ? 'BEARISH (shorts only)' : 'MIXED (no trades)'

// Protected extreme: lowest low (long) / highest high (short) from the broken
// internal swing pivot to the trigger bar; last 13 bars if the pivot is too old.
float phase6ProtectedExtreme = na
float phase6BrokenLevel = na
if phase6Side != 0
    int _pivotBar = phase6Side == 1 ? phase6InternalTopBar : phase6InternalBottomBar
    int _span = not na(_pivotBar) and bar_index - _pivotBar <= 200 ? bar_index - _pivotBar + 1 : 13
    for _offset = 0 to _span - 1
        if phase6Side == 1
            phase6ProtectedExtreme := na(phase6ProtectedExtreme) ? low[_offset] : math.min(phase6ProtectedExtreme, low[_offset])
        else
            phase6ProtectedExtreme := na(phase6ProtectedExtreme) ? high[_offset] : math.max(phase6ProtectedExtreme, high[_offset])
    phase6BrokenLevel := phase6Side == 1 ? itop_y : ibtm_y

// Bridge state: 3 on a trigger bar (handed to Engine 7), otherwise 0.
phase6StateCode = phase6Side != 0 ? 3 : 0
phase6ReadyForRisk = phase6StateCode == 3

// =============================================================================
// ENGINE 7 — STRUCTURAL TRADE CONSTRUCTION
// Entry: the trigger candle close.
// Stop: beyond the protected extreme + buffer (ATR-scaled); the trade is
//   skipped if that stop is wider than $15 or tighter than $2.
// TP1: 1.51R (rule: TP1 > 1.5R), only if no obstacle lies between entry and
//   TP1 (clean room). Obstacles: 15m Pivot S/R zones, unswept 15m EQH/EQL and
//   the 4H swing high/low. 15m Supply/Demand zones and Order Blocks are NOT
//   obstacles: measured over 2.75 years they did not hold, and treating them
//   as obstacles only removed good trades.
// TP2: 2.5R, or just in front of the first obstacle beyond TP1 if that comes
//   earlier; it must stay > TP1 + 0.25R. No room → NO TRADE.
// =============================================================================
phase7StopBufferATR = input.float(0.3, 'Stop buffer beyond protected extreme (ATR)', minval=0.0, step=0.05, group='Engine 7 — Construction', tooltip='Distance beyond the protected swing low/high, as a multiple of 5m ATR(89), so normal wicks do not reach the stop.')
phase7MaxStopUSD = input.float(15.0, 'Maximum stop distance ($)', minval=1.0, maxval=15.0, step=0.5, group='Engine 7 — Construction', tooltip='Rule: SL must not exceed $15. A setup whose structural stop needs more is skipped, never tightened inside structure.')
phase7MinStopUSD = input.float(2.0, 'Minimum stop distance ($)', minval=0.0, step=0.5, group='Engine 7 — Construction')
phase7TP1Multiple = input.float(1.51, 'TP1 (R multiple, must be > 1.5)', minval=1.51, maxval=5.0, step=0.01, group='Engine 7 — Construction')
phase7TP2Multiple = input.float(2.5, 'TP2 maximum (R multiple)', minval=1.75, maxval=9.5, step=0.25, group='Engine 7 — Construction')
phase7TargetFrontATR = input.float(0.1, 'TP2 front-run before an opposing zone (ATR)', minval=0.0, step=0.05, group='Engine 7 — Construction')
phase7RequireCleanRoom = input.bool(true, 'Require clean room to TP1 (no obstacle)', group='Engine 7 — Construction', tooltip='Obstacles: 15m Pivot S/R, unswept 15m EQH/EQL, 4H swing high/low.')

phase7_reason_code(_reason) =>
    _reason == 'VALID_TRADE' ? 1 :
      _reason == 'INVALID_RISK' ? 7 :
      _reason == 'SL_TOO_WIDE' ? 8 :
      _reason == 'SL_TOO_TIGHT' ? 9 :
      _reason == 'NO_CLEAN_ROOM' ? 10 :
      _reason == 'NO_TP2_ROOM' ? 11 : 0

// Phase 5 publishes the prior confirmed 15m snapshot; a liquidity level already
// taken inside the current 15m window is no longer an obstacle.
phase7_level_unswept(_price, _side) =>
    int _snapshotClose = na(phase5SetupTime) ? na : phase5SetupTime + int(timeframe.in_seconds(phase5SetupTf) * 1000)
    bool _swept = false
    if not na(_price) and not na(_snapshotClose)
        for _barOffset = 0 to 2
            if not na(time[_barOffset]) and time[_barOffset] >= _snapshotClose and (_side == 1 ? high[_barOffset] >= _price : low[_barOffset] <= _price)
                _swept := true
    not na(_price) and not na(_snapshotClose) and not _swept

// Nearest obstacle strictly beyond _from in the trade direction: the near edge
// of a 15m Pivot S/R zone, an unswept 15m EQH/EQL, or the 4H swing high/low.
phase7_nearest_opposing(_side, _from) =>
    float _best = na
    array<float> _zoneEdges = _side == 1 ?
      array.from(setup15mPivotResistance1Bottom, setup15mPivotResistance2Bottom, setup15mPivotResistance3Bottom) :
      array.from(setup15mPivotSupport1Top, setup15mPivotSupport2Top, setup15mPivotSupport3Top)
    array<float> _liquidity = _side == 1 ?
      array.from(setup15mEQH1, setup15mEQH2, setup15mEQH3, macro4HHigh) :
      array.from(setup15mEQL1, setup15mEQL2, setup15mEQL3, macro4HLow)
    for _edge in _zoneEdges
        if not na(_edge) and (_edge - _from) * _side > 0 and (na(_best) or math.abs(_edge - _from) < math.abs(_best - _from))
            _best := _edge
    for _level in _liquidity
        if not na(_level) and (_level - _from) * _side > 0 and phase7_level_unswept(_level, _side) and (na(_best) or math.abs(_level - _from) < math.abs(_best - _from))
            _best := _level
    _best

var int phase7LastProcessedReadyTime = na
var int phase7SetupId = na
var int phase7Side = 0
var string phase7EntryKind = 'NONE'
var float phase7ImpulseA = na
var float phase7ImpulseB = na
var float phase7ImpulseStrength = na
var float phase7Entry = na
var float phase7SL = na
var float phase7TP1 = na
var float phase7TP2 = na
var float phase7TP1R = na
var float phase7TP2R = na
var string phase7Reason = 'NO_SETUP'
var bool phase7BridgeValid = false

phase7NewReady = phase6ReadyForRisk and (na(phase7LastProcessedReadyTime) or time != phase7LastProcessedReadyTime)
if phase7NewReady
    phase7LastProcessedReadyTime := time
    phase7SetupId := na
    phase7Side := phase6Side
    phase7EntryKind := 'NONE'
    phase7ImpulseA := phase6ProtectedExtreme
    phase7ImpulseB := phase6BrokenLevel
    phase7ImpulseStrength := not na(exec5mATR) and exec5mATR > 0 ? math.abs(phase6BrokenLevel - phase6ProtectedExtreme) / exec5mATR : na
    phase7Entry := na
    phase7SL := na
    phase7TP1 := na
    phase7TP2 := na
    phase7TP1R := na
    phase7TP2R := na
    phase7BridgeValid := false
    float _entry = close
    float _stop = na(phase6ProtectedExtreme) or na(exec5mATR) ? na : phase6ProtectedExtreme - phase7Side * phase7StopBufferATR * exec5mATR
    float _risk = na(_stop) ? na : (_entry - _stop) * phase7Side
    if na(_risk) or _risk <= 0 or na(phase7ImpulseStrength) or (phase7ImpulseB - phase7ImpulseA) * phase7Side <= 0
        phase7Reason := 'INVALID_RISK'
    else if _risk > phase7MaxStopUSD
        phase7Reason := 'SL_TOO_WIDE'
    else if _risk < phase7MinStopUSD
        phase7Reason := 'SL_TOO_TIGHT'
    else
        float _tp1 = _entry + phase7Side * phase7TP1Multiple * _risk
        float _blocker = phase7_nearest_opposing(phase7Side, _entry)
        bool _blocked = phase7RequireCleanRoom and not na(_blocker) and (_tp1 - _blocker) * phase7Side > 0
        float _tp2Cap = _entry + phase7Side * phase7TP2Multiple * _risk
        float _beyond = phase7_nearest_opposing(phase7Side, _tp1)
        float _tp2 = not na(_beyond) and (_beyond - _tp2Cap) * phase7Side < 0 ? _beyond - phase7Side * phase7TargetFrontATR * exec5mATR : _tp2Cap
        if _blocked
            phase7Reason := 'NO_CLEAN_ROOM'
        else if (_tp2 - _tp1) * phase7Side <= 0.25 * _risk
            phase7Reason := 'NO_TP2_ROOM'
        else
            phase7SetupId := time
            phase7EntryKind := 'READY_CLOSE'
            phase7Entry := _entry
            phase7SL := _stop
            phase7TP1 := _tp1
            phase7TP2 := _tp2
            phase7TP1R := phase7TP1Multiple
            phase7TP2R := (_tp2 - _entry) * phase7Side / _risk
            phase7Reason := 'VALID_TRADE'
            phase7BridgeValid := true

phase7BridgeSideCode = phase7Side == 1 ? 1 : phase7Side == -1 ? 2 : 0
phase7BridgeEntryCode = phase7BridgeValid ? 1 : 0
phase7BridgeTP1Code = phase7BridgeValid ? int(math.floor(phase7TP1R * 10)) : 0
phase7BridgeTP2Code = phase7BridgeValid ? int(math.floor(phase7TP2R * 10)) : 0
phase7BridgeReasonCode = phase7_reason_code(phase7Reason)
phase7BridgeMeta = 70000000000 + (phase7BridgeValid ? 10000000000 : 0) + phase7BridgeSideCode * 1000000000 + phase7BridgeEntryCode * 100000000 + phase7BridgeTP1Code * 1000000 + phase7BridgeTP2Code * 10000 + phase7BridgeReasonCode

// Public split contract. Keep exactly ten hidden plots: TradingView permits a
// consumer to select at most ten outputs from other indicators. Distinct idle
// sentinels let the consumer verify every manually mapped channel before a
// valid package exists, without adding plots or changing price precision.
float phase7BridgeEvalSentinel = -710000001.0
float phase7BridgeEntrySentinel = -710000003.0
float phase7BridgeSLSentinel = -710000004.0
float phase7BridgeTP1Sentinel = -710000005.0
float phase7BridgeTP2Sentinel = -710000006.0
float phase7BridgeImpulseASentinel = -710000008.0
float phase7BridgeImpulseBSentinel = -710000009.0
float phase7BridgeStrengthSentinel = -710000010.0

plot(na(phase7LastProcessedReadyTime) ? phase7BridgeEvalSentinel : phase7LastProcessedReadyTime, 'BRIDGE_EVAL_ID', display=display.none)
plot(phase7BridgeMeta, 'BRIDGE_META', display=display.none)
plot(phase7BridgeValid ? phase7Entry : phase7BridgeEntrySentinel, 'BRIDGE_ENTRY', display=display.none)
plot(phase7BridgeValid ? phase7SL : phase7BridgeSLSentinel, 'BRIDGE_SL', display=display.none)
plot(phase7BridgeValid ? phase7TP1 : phase7BridgeTP1Sentinel, 'BRIDGE_TP1', display=display.none)
plot(phase7BridgeValid ? phase7TP2 : phase7BridgeTP2Sentinel, 'BRIDGE_TP2', display=display.none)
plot(phase6StateCode, 'BRIDGE_E6_STATE', display=display.none)
plot(phase7BridgeValid ? phase7ImpulseA : phase7BridgeImpulseASentinel, 'BRIDGE_IMPULSE_A', display=display.none)
plot(phase7BridgeValid ? phase7ImpulseB : phase7BridgeImpulseBSentinel, 'BRIDGE_IMPULSE_B', display=display.none)
plot(phase7BridgeValid ? phase7ImpulseStrength : phase7BridgeStrengthSentinel, 'BRIDGE_IMPULSE_STRENGTH', display=display.none)

// =============================================================================
// DECISION LEVELS ON THE CHART
// Draws exactly what the trade logic uses, so chart reading matches the logic:
// the 5m Supertrend, and the current clean-room obstacles (15m Pivot S/R zones,
// unswept 15m EQH/EQL, 4H swing high/low). Only levels within reach of a trade
// are drawn: TP2 is at most 2.5R with R at most $15, so a level farther than
// that from price can never block TP1 or cap TP2. Plotted after the ten bridge
// plots, so the Execution input mapping (plots 0-9) is unchanged.
// =============================================================================
phase6ShowLevels = input.bool(false, 'Show decision levels (Supertrend + obstacles)', group='Engine 6 — Trigger')
plot(phase6ShowLevels and phase6UseSupertrend ? phase6StLine : na, 'Supertrend 5m', color=phase6StTrend == 1 ? color.new(color.teal, 10) : color.new(color.red, 10), linewidth=1, style=plot.style_linebr)
phase6LevelReach = phase7TP2Multiple * phase7MaxStopUSD
var array<box> phase6LevelBoxes = array.new<box>()
var array<line> phase6LevelLines = array.new<line>()
var array<label> phase6LevelLabels = array.new<label>()
phase6_level_box(_top, _bottom, _color, _text) =>
    if not na(_top) and not na(_bottom) and (close >= _bottom and close <= _top or math.min(math.abs(_top - close), math.abs(_bottom - close)) <= phase6LevelReach)
        array.push(phase6LevelBoxes, box.new(bar_index - 60, _top, bar_index + 8, _bottom, border_color=color.new(_color, 40), bgcolor=color.new(_color, 85), text=_text, text_color=color.new(_color, 0), text_size=size.tiny, text_halign=text.align_right))
phase6_level_line(_price, _color, _text, _style) =>
    if not na(_price) and math.abs(_price - close) <= phase6LevelReach
        array.push(phase6LevelLines, line.new(bar_index - 60, _price, bar_index + 8, _price, color=color.new(_color, 20), style=_style, width=1))
        array.push(phase6LevelLabels, label.new(bar_index + 8, _price, _text, style=label.style_label_left, color=color.new(_color, 70), textcolor=color.white, size=size.tiny))
if barstate.islast
    for _b in phase6LevelBoxes
        box.delete(_b)
    for _l in phase6LevelLines
        line.delete(_l)
    for _t in phase6LevelLabels
        label.delete(_t)
    array.clear(phase6LevelBoxes)
    array.clear(phase6LevelLines)
    array.clear(phase6LevelLabels)
    if phase6ShowLevels
        phase6_level_box(setup15mPivotResistance1Top, setup15mPivotResistance1Bottom, color.red, '15m pivot R')
        phase6_level_box(setup15mPivotResistance2Top, setup15mPivotResistance2Bottom, color.red, '15m pivot R')
        phase6_level_box(setup15mPivotResistance3Top, setup15mPivotResistance3Bottom, color.red, '15m pivot R')
        phase6_level_box(setup15mPivotSupport1Top, setup15mPivotSupport1Bottom, color.green, '15m pivot S')
        phase6_level_box(setup15mPivotSupport2Top, setup15mPivotSupport2Bottom, color.green, '15m pivot S')
        phase6_level_box(setup15mPivotSupport3Top, setup15mPivotSupport3Bottom, color.green, '15m pivot S')
        // Liquidity is drawn only while it can still block a trade: unswept and
        // ahead of price (the same test Engine 7 applies).
        for _eqh in array.from(setup15mEQH1, setup15mEQH2, setup15mEQH3)
            phase6_level_line(not na(_eqh) and _eqh > close and phase7_level_unswept(_eqh, 1) ? _eqh : na, color.orange, 'EQH', line.style_dotted)
        for _eql in array.from(setup15mEQL1, setup15mEQL2, setup15mEQL3)
            phase6_level_line(not na(_eql) and _eql < close and phase7_level_unswept(_eql, -1) ? _eql : na, color.aqua, 'EQL', line.style_dotted)
        phase6_level_line(not na(macro4HHigh) and macro4HHigh > close and phase7_level_unswept(macro4HHigh, 1) ? macro4HHigh : na, color.fuchsia, '4H swing high', line.style_dashed)
        phase6_level_line(not na(macro4HLow) and macro4HLow < close and phase7_level_unswept(macro4HLow, -1) ? macro4HLow : na, color.fuchsia, '4H swing low', line.style_dashed)

phase5_bias_text(_state) =>
    _state == 1 ? 'Bullish' : _state == -1 ? 'Bearish' : 'Neutral'

phase5_direction_text(_state) =>
    _state == 1 ? 'Bullish break' : _state == -1 ? 'Bearish break' : 'No new break'

phase5_location_text(_state) =>
    _state == 1 ? 'Premium' : _state == -1 ? 'Discount' : _state == 0 ? 'Equilibrium' :
      _state == 2 ? 'Above equilibrium' : _state == -2 ? 'Below equilibrium' : 'Unavailable'

phase5_price_text(_price) =>
    na(_price) ? '—' : str.tostring(_price, format.mintick)

phase5_zone_text(_top, _bottom) =>
    na(_top) or na(_bottom) ? '—' : phase5_price_text(_bottom) + '–' + phase5_price_text(_top)

phase5_candidate_count(_top1, _top2, _top3) =>
    (not na(_top1) ? 1 : 0) + (not na(_top2) ? 1 : 0) + (not na(_top3) ? 1 : 0)

phase5_state_color(_state) =>
    _state == 1 ? color.new(color.lime, 70) : _state == -1 ? color.new(color.red, 70) : color.new(color.gray, 75)

phase5DebugOn = input.bool(false, 'Show MTF Debug Table', group='Phase 5 — Debug')
phase5DebugPosition = input.string(position.top_right, 'Table position', options=[position.top_right, position.top_left, position.bottom_right, position.bottom_left], group='Phase 5 — Debug')
var table phase5DebugTable = table.new(phase5DebugPosition, 2, 40, border_width=1)

phase5_debug_row(_row, _name, _value, _background) =>
    table.cell(phase5DebugTable, 0, _row, _name, text_color=color.white, bgcolor=color.new(color.black, 15), text_size=size.tiny)
    table.cell(phase5DebugTable, 1, _row, _value, text_color=color.white, bgcolor=_background, text_size=size.tiny)

if barstate.islast
    if phase5DebugOn
        table.cell(phase5DebugTable, 0, 0, 'PHASE 5 + ENGINE 6 BRAIN', text_color=color.white, bgcolor=color.new(color.purple, 20), text_size=size.tiny)
        table.cell(phase5DebugTable, 1, 0, phase5ExecutionTfOk and phase5TfHierarchyOk ? '5m chart OK' : 'Use locked 5m chart', text_color=color.white, bgcolor=phase5ExecutionTfOk and phase5TfHierarchyOk ? color.new(color.green, 55) : color.new(color.orange, 35), text_size=size.tiny)
        phase5_debug_row(1, '4H macro bias', phase5_bias_text(macro4HBias), phase5_state_color(macro4HBias))
        phase5_debug_row(2, '4H high / low', phase5_price_text(macro4HHigh) + ' / ' + phase5_price_text(macro4HLow), color.new(color.gray, 75))
        phase5_debug_row(3, '4H latest break', phase5_direction_text(macro4HBreak), phase5_state_color(macro4HBreak))
        phase5_debug_row(4, '1H primary bias', phase5_bias_text(bias1H), phase5_state_color(bias1H))
        phase5_debug_row(5, '1H confirmed swing location', phase5_location_text(bias1HLocation), color.new(color.gray, 75))
        phase5_debug_row(6, 'Previous D high / low', phase5_price_text(prevDayHigh) + ' / ' + phase5_price_text(prevDayLow), color.new(color.gray, 75))
        phase5_debug_row(7, 'Previous W high / low', phase5_price_text(prevWeekHigh) + ' / ' + phase5_price_text(prevWeekLow), color.new(color.gray, 75))
        phase5_debug_row(8, 'Previous M high / low', phase5_price_text(prevMonthHigh) + ' / ' + phase5_price_text(prevMonthLow), color.new(color.gray, 75))
        phase5_debug_row(9, '15m demand / supply', phase5_zone_text(setup15mDemandTop, setup15mDemandBottom) + ' / ' + phase5_zone_text(setup15mSupplyTop, setup15mSupplyBottom), color.new(color.gray, 75))
        phase5_debug_row(10, '15m bull / bear OB', phase5_zone_text(setup15mBullOBTop, setup15mBullOBBottom) + ' / ' + phase5_zone_text(setup15mBearOBTop, setup15mBearOBBottom), color.new(color.gray, 75))
        phase5_debug_row(11, '15m bull / bear FVG', phase5_zone_text(setup15mBullFVGTop, setup15mBullFVGBottom) + ' / ' + phase5_zone_text(setup15mBearFVGTop, setup15mBearFVGBottom), color.new(color.gray, 75))
        phase5_debug_row(12, '15m pivot S / R', phase5_zone_text(setup15mPivotSupportTop, setup15mPivotSupportBottom) + ' / ' + phase5_zone_text(setup15mPivotResistanceTop, setup15mPivotResistanceBottom), color.new(color.gray, 75))
        phase5_debug_row(13, '15m pool D/S BO/SO BF/SF PS/PR', str.tostring(phase5_candidate_count(setup15mDemand1Top, setup15mDemand2Top, setup15mDemand3Top)) + '/' + str.tostring(phase5_candidate_count(setup15mSupply1Top, setup15mSupply2Top, setup15mSupply3Top)) + ' ' + str.tostring(phase5_candidate_count(setup15mBullOB1Top, setup15mBullOB2Top, setup15mBullOB3Top)) + '/' + str.tostring(phase5_candidate_count(setup15mBearOB1Top, setup15mBearOB2Top, setup15mBearOB3Top)) + ' ' + str.tostring(phase5_candidate_count(setup15mBullFVG1Top, setup15mBullFVG2Top, setup15mBullFVG3Top)) + '/' + str.tostring(phase5_candidate_count(setup15mBearFVG1Top, setup15mBearFVG2Top, setup15mBearFVG3Top)) + ' ' + str.tostring(phase5_candidate_count(setup15mPivotSupport1Top, setup15mPivotSupport2Top, setup15mPivotSupport3Top)) + '/' + str.tostring(phase5_candidate_count(setup15mPivotResistance1Top, setup15mPivotResistance2Top, setup15mPivotResistance3Top)), color.new(color.gray, 75))
        phase5_debug_row(14, '15m EQH / EQL', phase5_price_text(setup15mEQH) + ' / ' + phase5_price_text(setup15mEQL), color.new(color.gray, 75))
        phase5_debug_row(15, '15m EQH / EQL pools', str.tostring(phase5_candidate_count(setup15mEQH1, setup15mEQH2, setup15mEQH3)) + ' / ' + str.tostring(phase5_candidate_count(setup15mEQL1, setup15mEQL2, setup15mEQL3)), color.new(color.gray, 75))
        phase5_debug_row(16, '15m confirmed swing high / low', phase5_price_text(setup15mSwingHigh) + ' / ' + phase5_price_text(setup15mSwingLow), color.new(color.gray, 75))
        phase5_debug_row(17, '15m confirmed swing location', phase5_location_text(setup15mLocation), color.new(color.gray, 75))
        phase5_debug_row(18, '5m internal / swing trend', phase5_bias_text(exec5mInternalTrend) + ' / ' + phase5_bias_text(exec5mSwingTrend), color.new(color.gray, 75))
        phase5_debug_row(19, '5m internal CHoCH B/S', str.tostring(exec5mInternalBullCHoCH) + ' / ' + str.tostring(exec5mInternalBearCHoCH), color.new(color.gray, 75))
        phase5_debug_row(20, '5m swing CHoCH B/S', str.tostring(exec5mSwingBullCHoCH) + ' / ' + str.tostring(exec5mSwingBearCHoCH), color.new(color.gray, 75))
        phase5_debug_row(21, '5m internal break B/S', str.tostring(exec5mInternalBullBreak) + ' / ' + str.tostring(exec5mInternalBearBreak), color.new(color.gray, 75))
        phase5_debug_row(22, '5m Supertrend (' + str.tostring(phase6StPeriod) + ', ' + str.tostring(phase6StFactor, '#.#') + ')', (phase6StTrend == 1 ? 'UP ' : 'DOWN ') + phase5_price_text(phase6StLine) + (phase6UseSupertrend ? '' : ' (filter OFF)'), phase5_state_color(phase6StTrend))
        phase5_debug_row(23, 'Trade side allowed now', phase6DirectionContext == 0 ? 'none (4H/1H mixed)' : phase6UseSupertrend and phase6StTrend != phase6DirectionContext ? 'none (Supertrend against)' : not phase6RegimeOk ? 'none (1H choppy)' : (phase6DirectionContext == 1 ? 'LONG' : 'SHORT') + (phase6UseFastPullback ? ' (fast break only)' : ''), phase5_state_color(phase6DirectionContext == 0 or (phase6UseSupertrend and phase6StTrend != phase6DirectionContext) or not phase6RegimeOk ? 0 : phase6DirectionContext))
        phase5_debug_row(24, 'Bars since pivot L / S (max ' + str.tostring(phase6MaxPullbackBars) + ')', (na(phase6LongPivotAge) ? '—' : str.tostring(phase6LongPivotAge)) + ' / ' + (na(phase6ShortPivotAge) ? '—' : str.tostring(phase6ShortPivotAge)) + (phase6UseFastPullback ? '' : ' (rule OFF)'), color.new(color.gray, 75))
        phase5_debug_row(25, '1H Choppiness (max ' + str.tostring(phase6ChopMax, '#') + ')', (na(phase6Chop1H) ? '—' : str.tostring(phase6Chop1H, '#.0')) + (phase6RegimeOk ? ' calm' : ' choppy') + (phase6UseCalm1H ? '' : ' (rule OFF)'), phase6RegimeOk ? color.new(color.green, 70) : color.new(color.orange, 55))
        phase5_debug_row(26, '5m ATR(89)', phase5_price_text(exec5mATR), color.new(color.gray, 75))
        phase5_debug_row(27, '', '', color.new(color.gray, 100))
        phase5_debug_row(28, 'E6 direction (4H + 1H)', phase6DirectionText, phase5_state_color(phase6DirectionContext))
        phase5_debug_row(29, 'E6 last trigger', na(phase7LastProcessedReadyTime) ? '—' : (phase7Side == 1 ? 'LONG ' : 'SHORT ') + str.format_time(phase7LastProcessedReadyTime, 'MM-dd HH:mm'), color.new(color.gray, 75))
        phase5_debug_row(30, 'E7 last result', phase7Reason, phase7BridgeValid ? color.new(color.green, 45) : color.new(color.orange, 55))
        phase5_debug_row(31, 'E7 protected extreme / broken', phase5_price_text(phase7ImpulseA) + ' / ' + phase5_price_text(phase7ImpulseB), color.new(color.gray, 75))
        phase5_debug_row(32, 'E7 entry', phase5_price_text(phase7Entry), color.new(color.blue, 60))
        phase5_debug_row(33, 'E7 SL / risk', phase5_price_text(phase7SL) + (na(phase7SL) ? '' : ' | $' + str.tostring(math.abs(phase7Entry - phase7SL), '#.##')), color.new(color.red, 60))
        phase5_debug_row(34, 'E7 TP1 / TP2 (R)', phase5_price_text(phase7TP1) + ' / ' + phase5_price_text(phase7TP2) + (na(phase7TP2R) ? '' : ' | ' + str.tostring(phase7TP1R, '#.##') + 'R / ' + str.tostring(phase7TP2R, '#.##') + 'R'), color.new(color.teal, 60))
        phase5_debug_row(35, 'E7 rules', 'SL ≤ $' + str.tostring(phase7MaxStopUSD, '#.#') + ' | TP1 ' + str.tostring(phase7TP1Multiple, '#.##') + 'R | clean room ' + (phase7RequireCleanRoom ? 'ON' : 'OFF'), color.new(color.gray, 75))
        phase5_debug_row(36, '', '', color.new(color.gray, 100))
        phase5_debug_row(37, '', '', color.new(color.gray, 100))
        phase5_debug_row(38, '', '', color.new(color.gray, 100))
        phase5_debug_row(39, '', '', color.new(color.gray, 100))
    else
        table.clear(phase5DebugTable, 0, 0, 1, 39)

// =============================================================================
// V7.5 STRATEGY TEST — ORDERS AND RESULTS (appended; the logic above is unchanged)
// =============================================================================
stRiskUSD = input.float(100.0, 'Risk per trade ($)', minval=1.0, step=10.0, group='Strategy test', tooltip='Position size = risk / stop distance, so net profit / risk = net R.')
stTP1ClosePct = input.int(50, 'Close at TP1 (%)', minval=1, maxval=100, group='Strategy test', tooltip='50 = the V7.5 system (runner to TP2 with the original stop). 100 = close everything at TP1; TradingView\'s "Percent profitable" then equals the project win rate.')
stShowTable = input.bool(true, 'Show results table', group='Strategy test')
stTablePosition = input.string(position.middle_right, 'Results table position', options=[position.middle_right, position.top_right, position.top_left, position.bottom_right, position.bottom_left, position.middle_left], group='Strategy test')

stTfOk = timeframe.period == '5'
// A new valid Engine 7 package on its own trigger bar: the same event the Execution
// script opens a trade on (it re-checks SL <= $15, TP1 > 1.5R and TP2 beyond TP1).
stRiskNow = math.abs(phase7Entry - phase7SL)
stNewPackage = stTfOk and phase7NewReady and phase7BridgeValid and stRiskNow > 0 and stRiskNow <= 15.0 + syminfo.mintick and
  math.abs(phase7TP1 - phase7Entry) / stRiskNow > 1.5 and math.abs(phase7TP2 - phase7Entry) > math.abs(phase7TP1 - phase7Entry)

var int stState = 0
var int stSide = 0
var float stEntry = na
var float stSL = na
var float stTP1 = na
var float stTP2 = na
var float stTP1R = na
var float stTP2R = na
var int stFillBar = na
var bool stTP1Hit = false
var int stTrades = 0
var int stWins = 0
var int stLosses = 0
var int stWinsTP2 = 0
var float stNetR = 0.0
var float stPeakR = 0.0
var float stMaxDDR = 0.0
var int stDays = 0
var int stFirstTime = na
if na(stFirstTime)
    stFirstTime := time
if timeframe.change('D')
    stDays += 1
stPart = stTP1ClosePct / 100.0

// Manage the live trade first (stop first when one candle touches both), then open.
if stTfOk and barstate.isconfirmed and stState == 1 and bar_index > stFillBar
    stStopNow = stSide == 1 ? low <= stSL : high >= stSL
    stTP1Now = stSide == 1 ? high >= stTP1 : low <= stTP1
    stTP2Now = stSide == 1 ? high >= stTP2 : low <= stTP2
    if stStopNow or stTP2Now or (stTP1Now and stPart >= 1.0)
        bool stIsWin = stTP1Hit or not stStopNow
        float stR = not stIsWin ? -1.0 : stPart >= 1.0 ? stTP1R : stStopNow ? stPart * stTP1R - (1 - stPart) : stPart * stTP1R + (1 - stPart) * stTP2R
        stWins += stIsWin ? 1 : 0
        stLosses += stIsWin ? 0 : 1
        stWinsTP2 += stIsWin and not stStopNow and stPart < 1.0 ? 1 : 0
        stNetR += stR
        stPeakR := math.max(stPeakR, stNetR)
        stMaxDDR := math.max(stMaxDDR, stPeakR - stNetR)
        stState := 0
    else if stTP1Now and not stTP1Hit
        stTP1Hit := true

if stNewPackage and stState == 0 and strategy.position_size == 0
    stSide := phase7Side
    stEntry := phase7Entry
    stSL := phase7SL
    stTP1 := phase7TP1
    stTP2 := phase7TP2
    stTP1R := math.abs(stTP1 - stEntry) / math.abs(stEntry - stSL)
    stTP2R := math.abs(stTP2 - stEntry) / math.abs(stEntry - stSL)
    stFillBar := bar_index
    stTP1Hit := false
    stState := 1
    stTrades += 1
    float stQty = stRiskUSD / (math.abs(stEntry - stSL) * syminfo.pointvalue)
    string stId = stSide == 1 ? 'V7.5 LONG' : 'V7.5 SHORT'
    strategy.entry(stId, stSide == 1 ? strategy.long : strategy.short, qty=stQty)
    if stTP1ClosePct < 100
        strategy.exit('TP1', from_entry=stId, qty_percent=stTP1ClosePct, limit=stTP1, stop=stSL, comment_profit='TP1 WIN', comment_loss='SL before TP1')
        strategy.exit('TP2', from_entry=stId, qty_percent=100, limit=stTP2, stop=stSL, comment_profit='TP2 WIN', comment_loss='SL')
    else
        strategy.exit('TP1', from_entry=stId, limit=stTP1, stop=stSL, comment_profit='TP1 WIN', comment_loss='SL before TP1')

st_r_text(_r) =>
    (_r >= 0 ? '+' : '') + str.tostring(_r, '#.##') + 'R'

var table stTable = table.new(stTablePosition, 2, 11, border_width=1)
st_row(_row, _name, _value, _bg) =>
    table.cell(stTable, 0, _row, _name, text_color=color.white, bgcolor=color.new(color.black, 15), text_size=size.small)
    table.cell(stTable, 1, _row, _value, text_color=color.white, bgcolor=_bg, text_size=size.small)

// A strategy only calculates on confirmed bars: draw on the last confirmed history bar too.
if (barstate.islast or barstate.islastconfirmedhistory) and stShowTable
    _closed = stWins + stLosses
    table.cell(stTable, 0, 0, 'V7.5 STRATEGY TEST', text_color=color.white, bgcolor=color.new(color.purple, 20), text_size=size.small)
    table.cell(stTable, 1, 0, stTfOk ? 'your rules: TP1/TP2 = WIN, SL first = LOSS' : 'Switch chart to 5m', text_color=color.white, bgcolor=stTfOk ? color.new(color.green, 55) : color.new(color.red, 35), text_size=size.small)
    st_row(1, 'History tested', str.format_time(stFirstTime, 'yyyy-MM-dd') + ' → ' + str.format_time(time, 'yyyy-MM-dd') + ' (' + str.tostring(stDays) + ' days)', color.new(color.gray, 75))
    st_row(2, 'Trades (per day)', str.tostring(stTrades) + ' (' + (stDays > 0 ? str.tostring(float(stTrades) / stDays, '#.##') : '—') + ')' + (stState == 1 ? ' | 1 open' : ''), color.new(color.gray, 75))
    st_row(3, 'Wins / losses', str.tostring(stWins) + ' / ' + str.tostring(stLosses) + ' | TP2 ' + str.tostring(stWinsTP2), color.new(color.gray, 75))
    st_row(4, 'Win rate (TP1 before SL)', _closed > 0 ? str.tostring(100.0 * stWins / _closed, '#.#') + '%' : '—', _closed == 0 ? color.new(color.gray, 75) : color.new(color.teal, 45))
    st_row(5, 'Net R (before costs)', st_r_text(stNetR), stNetR >= 0 ? color.new(color.green, 55) : color.new(color.red, 55))
    st_row(6, 'Max drawdown (R)', str.tostring(stMaxDDR, '#.##') + 'R', color.new(color.gray, 75))
    st_row(7, 'Net profit $ (after costs)', str.tostring(strategy.netprofit, '#,###.##') + ' | risk $' + str.tostring(stRiskUSD, '#'), strategy.netprofit >= 0 ? color.new(color.green, 55) : color.new(color.red, 55))
    st_row(8, 'Profit factor $', strategy.grossloss > 0 ? str.tostring(strategy.grossprofit / strategy.grossloss, '#.##') : '—', color.new(color.gray, 75))
    st_row(9, 'Max drawdown $', str.tostring(strategy.max_drawdown, '#,###.##'), color.new(color.gray, 75))
    st_row(10, 'Close at TP1', str.tostring(stTP1ClosePct) + '%' + (stTP1ClosePct < 100 ? ' | runner keeps the original SL' : ''), color.new(color.gray, 75))
