  phase5SetupBearFVG3TopRaw, phase5SetupBearFVG3BottomRaw, phase5SetupBearFVG3FreshRaw,
  phase5SetupPivotSupport1TopRaw, phase5SetupPivotSupport1BottomRaw, phase5SetupPivotSupport1OriginRaw, phase5SetupPivotSupport1ConfirmedRaw, phase5SetupPivotSupport1FreshRaw,
  phase5SetupPivotSupport2TopRaw, phase5SetupPivotSupport2BottomRaw, phase5SetupPivotSupport2OriginRaw, phase5SetupPivotSupport2ConfirmedRaw, phase5SetupPivotSupport2FreshRaw,
  phase5SetupPivotSupport3TopRaw, phase5SetupPivotSupport3BottomRaw, phase5SetupPivotSupport3OriginRaw, phase5SetupPivotSupport3ConfirmedRaw, phase5SetupPivotSupport3FreshRaw,
  phase5SetupPivotResistance1TopRaw, phase5SetupPivotResistance1BottomRaw, phase5SetupPivotResistance1OriginRaw, phase5SetupPivotResistance1ConfirmedRaw, phase5SetupPivotResistance1FreshRaw,
  phase5SetupPivotResistance2TopRaw, phase5SetupPivotResistance2BottomRaw, phase5SetupPivotResistance2OriginRaw, phase5SetupPivotResistance2ConfirmedRaw, phase5SetupPivotResistance2FreshRaw,
  phase5SetupPivotResistance3TopRaw, phase5SetupPivotResistance3BottomRaw, phase5SetupPivotResistance3OriginRaw, phase5SetupPivotResistance3ConfirmedRaw, phase5SetupPivotResistance3FreshRaw,
  phase5SetupEQH1Raw, phase5SetupEQH2Raw, phase5SetupEQH3Raw, phase5SetupEQL1Raw, phase5SetupEQL2Raw, phase5SetupEQL3Raw,
  phase5SetupLocationRaw, phase5SetupSwingHighRaw, phase5SetupSwingLowRaw] =
  request.security(syminfo.tickerid, phase5SetupTf, phase5_setup_packet(), lookahead=barmerge.lookahead_on, calc_bars_count=phase5SetupHistoryBars)

// -----------------------------------------------------------------------------
// PHASE 5 / PIECE 6 OF 8 — 5m Execution Context Module
// Reuses current-chart engines and publishes both live and confirmed states.
// -----------------------------------------------------------------------------
phase5ExecInternalTrendLive = itrend
phase5ExecSwingTrendLive = trend
phase5ExecTrendLive = phase5ExecInternalTrendLive
phase5ExecInternalBullChochLive = bull_ichoch_alert
phase5ExecInternalBearChochLive = bear_ichoch_alert
