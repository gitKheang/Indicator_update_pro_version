  phase5SetupSupply3TopRaw, phase5SetupSupply3BottomRaw, phase5SetupSupply3OriginRaw, phase5SetupSupply3ConfirmedRaw, phase5SetupSupply3FreshRaw,
  phase5SetupBullOB1TopRaw, phase5SetupBullOB1BottomRaw, phase5SetupBullOB1OriginRaw, phase5SetupBullOB1ConfirmedRaw, phase5SetupBullOB1FreshRaw,
  phase5SetupBullOB2TopRaw, phase5SetupBullOB2BottomRaw, phase5SetupBullOB2OriginRaw, phase5SetupBullOB2ConfirmedRaw, phase5SetupBullOB2FreshRaw,
  phase5SetupBullOB3TopRaw, phase5SetupBullOB3BottomRaw, phase5SetupBullOB3OriginRaw, phase5SetupBullOB3ConfirmedRaw, phase5SetupBullOB3FreshRaw,
  phase5SetupBearOB1TopRaw, phase5SetupBearOB1BottomRaw, phase5SetupBearOB1OriginRaw, phase5SetupBearOB1ConfirmedRaw, phase5SetupBearOB1FreshRaw,
  phase5SetupBearOB2TopRaw, phase5SetupBearOB2BottomRaw, phase5SetupBearOB2OriginRaw, phase5SetupBearOB2ConfirmedRaw, phase5SetupBearOB2FreshRaw,
  phase5SetupBearOB3TopRaw, phase5SetupBearOB3BottomRaw, phase5SetupBearOB3OriginRaw, phase5SetupBearOB3ConfirmedRaw, phase5SetupBearOB3FreshRaw,
  phase5SetupBullFVG1TopRaw, phase5SetupBullFVG1BottomRaw, phase5SetupBullFVG1FreshRaw,
  phase5SetupBullFVG2TopRaw, phase5SetupBullFVG2BottomRaw, phase5SetupBullFVG2FreshRaw,
  phase5SetupBullFVG3TopRaw, phase5SetupBullFVG3BottomRaw, phase5SetupBullFVG3FreshRaw,
